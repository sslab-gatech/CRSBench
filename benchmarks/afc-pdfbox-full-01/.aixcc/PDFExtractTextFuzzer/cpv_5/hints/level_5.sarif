  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-789",
              "name": "CWE-789: Memory Allocation with Excessive Size Value",
              "shortDescription": {
                "text": "Memory Allocation with Excessive Size Value"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Memory Allocation with Excessive Size Value"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-789",
          "level": "warning",
          "message": {
            "text": "CWE-789 - Memory Allocation with Excessive Size Value\nVulnerability: Type1Font int overflow into OOM\nDescription: A PDF with a crafted Type1 Font can trigger an OutOfMemoryError when the  heap is < 2GB on a very small input file."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fontbox/src/main/java/org/apache/fontbox/pfb/PfbParser.java"
                },
                "region": {
                  "startLine": 161,
                  "endLine": 166,
                  "startColumn": 13,
                  "endColumn": 40
                }
              },
              "logicalLocations": [
                {
                  "name": "parsePfb",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}