diff --git a/pdfbox/src/main/java/org/apache/pdfbox/ocr/OCRStreamEngine.java b/pdfbox/src/main/java/org/apache/pdfbox/ocr/OCRStreamEngine.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb0a9f79a765929f63cff4e088914678b1308127
--- /dev/null
+++ b/pdfbox/src/main/java/org/apache/pdfbox/ocr/OCRStreamEngine.java
@@ -0,0 +1,260 @@
+package org.apache.pdfbox.ocr;
+
+import static java.nio.charset.StandardCharsets.UTF_8;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.io.StringWriter;
+import java.io.Writer;
+import java.nio.file.FileVisitResult;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.SimpleFileVisitor;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+
+import javax.imageio.ImageIO;
+
+import org.apache.pdfbox.pdmodel.PDDocument;
+import org.apache.pdfbox.pdmodel.PDPageTree;
+import org.apache.pdfbox.rendering.PDFRenderer;
+
+/**
+ * Engine for running tesseract-ocr on each page and extracting text
+ *
+ * This is NOT threadsafe.
+ */
+public class OCRStreamEngine {
+
+    private static final String TESSERACT_PATH_KEY = "tesseract-path";
+    private PDFRenderer pdfRenderer = null;
+    private String tesseractPath = "tesseract";
+    private int pageIndex = 0;
+
+    private int startPage = -1;
+    private int endPage = -1;
+    private long timeoutMillisPerPage = 30000;
+
+    private final PDDocument pdDocument;
+    private Path tmpDir;
+
+    public OCRStreamEngine(PDDocument pdDocument) {
+        this.pdDocument = pdDocument;
+        pdfRenderer = new PDFRenderer(pdDocument);
+    }
+
+
+    public void setTimeoutMillisPerPage(long millisPerPage) {
+        this.timeoutMillisPerPage = millisPerPage;
+    }
+
+    public void setTesseractPath(String tesseractPath) {
+        this.tesseractPath = tesseractPath;
+    }
+    /**
+     * This will return the text of a document. See writeText. <br>
+     * NOTE: The document must not be encrypted when coming into this method.
+     *
+     * @return The text of the PDF document.
+     * @throws IOException if the doc state is invalid or it is encrypted.
+     */
+    public String getText(int startPage, int endPage) throws IOException {
+        this.startPage = startPage;
+        this.endPage = endPage;
+        return getText();
+    }
+
+
+    /**
+     * This will return the text of a document. See writeText. <br>
+     * NOTE: The document must not be encrypted when coming into this method.
+     *
+     * @return The text of the PDF document.
+     * @throws IOException if the doc state is invalid or it is encrypted.
+     */
+    public String getText() throws IOException
+    {
+        StringWriter outputStream = new StringWriter();
+        pageIndex = 0;
+        try {
+            tmpDir = Files.createTempDirectory("pdfbox-ocr");
+            writeText(pdDocument, outputStream);
+            return outputStream.toString();
+        } finally {
+            if (tmpDir != null) {
+                quietlyDeleteDir(tmpDir);
+            }
+        }
+    }
+
+    private void quietlyDeleteDir(Path tmpDir) {
+        try {
+            Files.walkFileTree(tmpDir, new SimpleFileVisitor<Path>() {
+                @Override
+                public FileVisitResult visitFile(Path file, BasicFileAttributes attrs)
+                        throws IOException {
+                    Files.delete(file);
+                    return FileVisitResult.CONTINUE;
+                }
+
+                @Override
+                public FileVisitResult postVisitDirectory(Path dir, IOException exc)
+                        throws IOException {
+                    Files.delete(dir);
+                    return FileVisitResult.CONTINUE;
+                }
+            });
+        } catch (IOException e) {
+            //log
+        }
+    }
+
+    /**
+     * This will take a PDDocument and write the text of that document to the print writer.
+     *
+     * @param doc The document to get the data from.
+     * @param outputStream The location to put the text.
+     *
+     * @throws IOException If the doc is in an invalid state.
+     */
+    private void writeText(PDDocument doc, Writer outputStream) throws IOException
+    {
+        processPages(doc.getPages(), outputStream);
+    }
+
+    public void processPages(PDPageTree pages, Writer outputStream) throws IOException {
+        if (startPage < 0 || endPage < 0) {
+            for (int i = 0; i < pages.getCount(); i++) {
+                processPage(outputStream);
+            }
+        } else {
+            startPage = pageIndex;
+            for (int i = startPage; i <= endPage && i < pages.getCount(); i++) {
+                processPage(outputStream);
+            }
+        }
+    }
+
+    public void processPage(Writer writer) throws IOException {
+        try {
+            BufferedImage image = pdfRenderer.renderImage(pageIndex);
+            Path target = Files.createTempFile(tmpDir, "render-" + pageIndex + "-", ".png");
+            ImageIO.write(image, "PNG", target.toFile());
+            String txt = runTesseract(target);
+            writer.append(txt).append("\n");
+        } finally {
+            pageIndex++;
+        }
+    }
+
+    private String runTesseract(Path image) throws IOException {
+        String actualTessPath = pdDocument.getDocumentInformation()
+                .getCustomMetadataValue(TESSERACT_PATH_KEY);
+        if (actualTessPath == null || actualTessPath.isEmpty()) {
+            actualTessPath = tesseractPath;
+        }
+
+        Path txt = Paths.get(image.toAbsolutePath().toString());
+        doOCR(actualTessPath, image, txt);
+        return extractContent(txt);
+    }
+
+    private String extractContent(Path base) throws IOException {
+        Path txt = Paths.get(base.toAbsolutePath() + ".txt");
+        if (Files.isRegularFile(txt)) {
+            return Files.readString(txt, UTF_8);
+        }
+        //log missing txt file
+        return "";
+    }
+
+    private void doOCR(String actualTesseractPath, Path input, Path output)
+            throws IOException {
+
+        ArrayList<String> cmd = new ArrayList<>(
+                Arrays.asList(actualTesseractPath, input.toAbsolutePath().toString(),
+                        output.toAbsolutePath().toString()));
+
+        ProcessBuilder pb = new ProcessBuilder(cmd);
+
+        Process process = null;
+
+        try {
+            process = pb.start();
+            runOCRProcess(process, timeoutMillisPerPage);
+        } finally {
+            if (process != null) {
+                process.destroyForcibly();
+            }
+        }
+    }
+
+    private void runOCRProcess(Process process, long timeoutMillis) throws IOException {
+        process.getOutputStream().close();
+        InputStream out = process.getInputStream();
+        InputStream err = process.getErrorStream();
+        StringBuilder outBuilder = new StringBuilder();
+        StringBuilder errBuilder = new StringBuilder();
+        Thread outThread = logStream(out, outBuilder);
+        Thread errThread = logStream(err, errBuilder);
+        outThread.start();
+        errThread.start();
+
+        int exitValue = Integer.MIN_VALUE;
+        try {
+            boolean finished = process.waitFor(timeoutMillis, TimeUnit.MILLISECONDS);
+            if (!finished) {
+                throw new IOException(new TimeoutException());
+            }
+            exitValue = process.exitValue();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return;
+        }
+        if (exitValue > 0) {
+            try {
+                //make sure this thread is actually done
+                errThread.join(1000);
+            } catch (InterruptedException e) {
+                //swallow
+            }
+            throw new IOException(
+                    "TesseractOCRParser bad exit value " + exitValue + " err msg: " +
+                            errBuilder.toString());
+        }
+    }
+
+    /**
+     * Starts a thread that reads the contents of the standard output or error
+     * stream of the given process to not block the process. The stream is closed
+     * once fully processed.
+     */
+    private Thread logStream(final InputStream stream, final StringBuilder out) {
+        return new Thread(() -> {
+            Reader reader = new InputStreamReader(stream, UTF_8);
+            char[] buffer = new char[1024];
+            try {
+                for (int n = reader.read(buffer); n != -1; n = reader.read(buffer)) {
+                    out.append(buffer, 0, n);
+                }
+            } catch (IOException e) {
+                //swallow
+            } finally {
+                if (stream != null) {
+                    try {
+                        stream.close();
+                    } catch (IOException e) {
+                        //swallow
+                    }
+                }
+            }
+        });
+    }
+}
diff --git a/pdfbox/src/test/java/org/apache/pdfbox/ocr/TestOCR.java b/pdfbox/src/test/java/org/apache/pdfbox/ocr/TestOCR.java
new file mode 100644
index 0000000000000000000000000000000000000000..06c45af23d524185993639870120dbaab3f9b877
--- /dev/null
+++ b/pdfbox/src/test/java/org/apache/pdfbox/ocr/TestOCR.java
@@ -0,0 +1,66 @@
+package org.apache.pdfbox.ocr;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+import org.apache.pdfbox.Loader;
+import org.apache.pdfbox.pdmodel.PDDocument;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+public class TestOCR {
+
+    static String TESSERACT_PATH;
+
+    @BeforeAll
+    static void setUp() {
+        //these are some common locations for tesseract on linux
+        if (Files.isExecutable(Paths.get("/usr/bin/tesseract")))
+        {
+            TESSERACT_PATH = "/usr/bin/tesseract";
+        }
+        else if (Files.isExecutable(Paths.get("/usr/my-bin/tesseract")))
+        {
+            TESSERACT_PATH = "/usr/my-bin/tesseract";
+        }
+        else
+        {
+            TESSERACT_PATH = null;
+        }
+    }
+
+
+    @Test
+    public void testBasic() throws Exception
+    {
+        if (TESSERACT_PATH == null)
+        {
+            return;
+        }
+        Path p = Paths.get(TestOCR.class.getResource("testOCR.pdf").toURI());
+        PDDocument pdDocument = Loader.loadPDF(p.toFile());
+        OCRStreamEngine ocrStreamEngine = new OCRStreamEngine(pdDocument);
+        ocrStreamEngine.setTesseractPath(TESSERACT_PATH);
+        String txt = ocrStreamEngine.getText(1, 1);
+        System.out.println("txt: " + txt);
+        assertTrue(txt.contains("Happy New Year"));
+    }
+
+    @Test
+    public void testOverride() throws Exception
+    {
+        if (!Files.isExecutable(Paths.get("/usr/my-bin/tesseract")))
+        {
+            return;
+        }
+        Path p = Paths.get(TestOCR.class.getResource("testOCRCustomPath.pdf").toURI());
+        PDDocument pdDocument = Loader.loadPDF(p.toFile());
+        OCRStreamEngine ocrStreamEngine = new OCRStreamEngine(pdDocument);
+        ocrStreamEngine.setTesseractPath("some-other-path");
+        String txt = ocrStreamEngine.getText(1, 1);
+        assertTrue(txt.contains("Happy New Year"));
+    }
+}
