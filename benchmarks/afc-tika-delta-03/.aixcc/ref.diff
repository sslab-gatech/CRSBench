+package org.apache.tika.parser.threedxml;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import org.apache.tika.TikaTest;
+import org.apache.tika.metadata.Metadata;
+import org.apache.tika.metadata.TikaCoreProperties;
+
+public class ThreeDXMLParserTest extends TikaTest {
+
+    //test file comes from:
+    // https://www.dmg-lib.org/dmglib/main/portal.jsp?mainNaviState=browsen.caxfi.viewer&id=5563053
+    @Test
+    public void testBasic() throws Exception {
+        Path p =
+                Paths.get(ThreeDXMLParser.class.getResource("/test-documents/test3Dxml.3dxml").toURI());
+        List<Metadata> metadataList = getRecursiveMetadata(p);
+        Metadata m = metadataList.get(0);
+        assertEquals("Mike-7", m.get(TikaCoreProperties.CREATOR));
+        assertEquals("Assemblage_complet 3D XML File", m.get(TikaCoreProperties.TITLE));
+        assertEquals("CATIA V5", m.get(TikaCoreProperties.CREATOR_TOOL));
+        assertContains("<p>Coussinet_colerette.14</p>", m.get(TikaCoreProperties.TIKA_CONTENT));
+    }
+}
