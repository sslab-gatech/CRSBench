+package org.apache.tika.detect.zip.threedxml;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Locale;
+
+import org.apache.commons.compress.archivers.zip.ZipArchiveEntry;
+import org.apache.commons.compress.archivers.zip.ZipFile;
+import org.xml.sax.Attributes;
+import org.xml.sax.SAXException;
+import org.xml.sax.helpers.DefaultHandler;
+
+import org.apache.tika.detect.zip.StreamingDetectContext;
+import org.apache.tika.detect.zip.ZipContainerDetector;
+import org.apache.tika.exception.TikaException;
+import org.apache.tika.io.TikaInputStream;
+import org.apache.tika.mime.MediaType;
+import org.apache.tika.parser.ParseContext;
+import org.apache.tika.parser.threedxml.ThreeDXMLParser;
+import org.apache.tika.utils.XMLReaderUtils;
+
+public class ThreeDXMLDetector implements ZipContainerDetector {
+    @Override
+    public MediaType detect(ZipFile zipFile, TikaInputStream tis) throws IOException {
+        ZipArchiveEntry zipEntry = zipFile.getEntry("Manifest.xml");
+        if (zipEntry == null) {
+            return null;
+        }
+        ManifestHandler manifestHandler = new ManifestHandler();
+        try (InputStream is = zipFile.getInputStream(zipEntry)) {
+            XMLReaderUtils.parseSAX(is, manifestHandler, new ParseContext());
+        } catch (TikaException | SAXException e) {
+            //swallow
+        }
+        String root = manifestHandler.getRoot();
+        if (root.toLowerCase(Locale.ROOT).endsWith(".3dxml")) {
+            return ThreeDXMLParser.MEDIA_TYPE;
+        }
+        return null;
+    }
+
+    @Override
+    public MediaType streamingDetectUpdate(ZipArchiveEntry zae, InputStream zis,
+                                           StreamingDetectContext detectContext)
+            throws IOException {
+        if (zae.getName().equals("Manifest.xml")) {
+            ManifestHandler manifestHandler = new ManifestHandler();
+            try {
+                XMLReaderUtils.parseSAX(zis, manifestHandler, new ParseContext());
+            } catch (TikaException | SAXException e) {
+                //swallow
+            }
+            String root = manifestHandler.getRoot();
+            if (root.toLowerCase(Locale.ROOT).endsWith(".3dxml")) {
+                detectContext.set(ThreeDXMLDetectorInfo.class, new ThreeDXMLDetectorInfo());
+                return ThreeDXMLParser.MEDIA_TYPE;
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public MediaType streamingDetectFinal(StreamingDetectContext detectContext) {
+        if (detectContext.get(ThreeDXMLDetectorInfo.class) != null) {
+            return ThreeDXMLParser.MEDIA_TYPE;
+        }
+        return null;
+    }
+
+    private class ThreeDXMLDetectorInfo {
+
+    }
+
+    private static class ManifestHandler extends DefaultHandler {
+        private static String ROOT = "Root";
+        boolean inRoot = false;
+        StringBuilder root = new StringBuilder();
+        @Override
+        public void startElement(String uri, String localName, String qName, Attributes attributes)
+                throws SAXException {
+            if (ROOT.equals(localName)) {
+                inRoot = true;
+            }
+        }
+
+        @Override
+        public void endElement(String uri, String localName, String qName) throws SAXException {
+            if (ROOT.equals(localName)) {
+                inRoot = false;
+            }
+        }
+
+        @Override
+        public void characters(char[] ch, int start, int length) throws SAXException {
+            if (inRoot) {
+                root.append(ch, start, length);
+            }
+        }
+
+        private String getRoot() {
+            return root.toString();
+        }
+    }
+}
