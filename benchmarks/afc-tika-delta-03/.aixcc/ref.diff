+package org.apache.tika.parser.threedxml;
+
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.Map;
+import java.util.Set;
+import javax.xml.parsers.ParserConfigurationException;
+import javax.xml.parsers.SAXParser;
+import javax.xml.parsers.SAXParserFactory;
+
+import org.apache.commons.compress.archivers.zip.ZipArchiveEntry;
+import org.apache.commons.compress.archivers.zip.ZipFile;
+import org.apache.commons.io.input.CloseShieldInputStream;
+import org.xml.sax.Attributes;
+import org.xml.sax.ContentHandler;
+import org.xml.sax.SAXException;
+import org.xml.sax.helpers.AttributesImpl;
+import org.xml.sax.helpers.DefaultHandler;
+
+import org.apache.tika.config.Initializable;
+import org.apache.tika.config.InitializableProblemHandler;
+import org.apache.tika.config.Param;
+import org.apache.tika.exception.TikaConfigException;
+import org.apache.tika.exception.TikaException;
+import org.apache.tika.io.TemporaryResources;
+import org.apache.tika.io.TikaInputStream;
+import org.apache.tika.metadata.Metadata;
+import org.apache.tika.metadata.TikaCoreProperties;
+import org.apache.tika.mime.MediaType;
+import org.apache.tika.parser.ParseContext;
+import org.apache.tika.parser.Parser;
+import org.apache.tika.sax.XHTMLContentHandler;
+import org.apache.tika.utils.XMLReaderUtils;
+
+public class ThreeDXMLParser implements Parser, Initializable {
+
+    /**
+     * Serial version UID
+     */
+    private static final long serialVersionUID = -752276948656079347L;
+
+    public static final MediaType MEDIA_TYPE = MediaType.application("x-3dxmlplugin");
+
+    private static final Set<MediaType> SUPPORTED_TYPES;
+
+    static {
+        SUPPORTED_TYPES = Collections.singleton(MEDIA_TYPE);
+    }
+
+
+    @Override
+    public Set<MediaType> getSupportedTypes(ParseContext context) {
+        return SUPPORTED_TYPES;
+    }
+
+    @Override
+    public void parse(InputStream stream, ContentHandler handler, Metadata metadata,
+                      ParseContext context) throws IOException, SAXException, TikaException {
+        TikaInputStream tis = TikaInputStream.cast(stream);
+        TemporaryResources tmp = null;
+        if (tis == null) {
+            tmp = new TemporaryResources();
+            tis = TikaInputStream.get(CloseShieldInputStream.wrap(stream), tmp, metadata);
+        }
+        try {
+            XHTMLContentHandler xhtml = new XHTMLContentHandler(handler, metadata);
+            xhtml.startDocument();
+            parseContent(tis, xhtml, metadata, context);
+            xhtml.endDocument();
+        } finally {
+            if (tmp != null) {
+                tis.close();
+            }
+        }
+    }
+
+    private void parseContent(TikaInputStream tis, ContentHandler handler, Metadata metadata,
+                              ParseContext context)
+            throws IOException, TikaException, SAXException {
+        Object container = tis.getOpenContainer();
+        if (container instanceof ZipFile) {
+            processZip((ZipFile) container, handler, metadata, context);
+            return;
+        }
+        try (ZipFile zipFile = ZipFile.builder().setPath(tis.getPath()).get()) {
+            processZip(zipFile, handler, metadata, context);
+        }
+
+    }
+
+    private void processZip(ZipFile zipFile, ContentHandler handler, Metadata metadata,
+                            ParseContext context) throws IOException, TikaException, SAXException {
+        ZipArchiveEntry manifestEntry = zipFile.getEntry("Manifest.xml");
+        if (manifestEntry == null) {
+            //log
+            return;
+        }
+        ManifestHandler manifestHandler = new ManifestHandler();
+        try (InputStream is = zipFile.getInputStream(manifestEntry)) {
+            XMLReaderUtils.parseSAX(is, manifestHandler, context);
+        }
+        parseRoot(manifestHandler.getRoot(), zipFile, handler, metadata, context);
+    }
+
+    private void parseRoot(String root, ZipFile zipFile, ContentHandler handler, Metadata metadata,
+                           ParseContext context) throws SAXException, IOException, TikaException {
+        ZipArchiveEntry rootEntry = zipFile.getEntry(root);
+        if (rootEntry == null) {
+            return;
+        }
+        SAXParserFactory factory = SAXParserFactory.newInstance();
+        factory.setNamespaceAware(true);
+        
+        SAXParser parser = null;
+        try {
+            parser = factory.newSAXParser();
+        } catch (ParserConfigurationException e) {
+            throw new SAXException(e);
+        }
+
+        RootHandler rootHandler = new RootHandler(handler, metadata);
+        try (InputStream is = zipFile.getInputStream(rootEntry)) {
+            parser.parse(is, rootHandler);
+        }
+    }
+
+    @Override
+    public void initialize(Map<String, Param> params) throws TikaConfigException {
+
+    }
+
+    @Override
+    public void checkInitialization(InitializableProblemHandler problemHandler)
+            throws TikaConfigException {
+
+    }
+
+    private static class RootHandler extends DefaultHandler {
+        private enum STATE {
+            TITLE, AUTHOR, GENERATOR, CREATED, OTHER;
+            StringBuilder sb = new StringBuilder();
+
+            String getValue() {
+                return sb.toString();
+            }
+        }
+
+        ;
+        private final ContentHandler handler;
+        private final Metadata metadata;
+        private STATE state = STATE.OTHER;
+
+        public RootHandler(ContentHandler handler, Metadata metadata) {
+            this.handler = handler;
+            this.metadata = metadata;
+        }
+
+        @Override
+        public void startElement(String uri, String localName, String qName, Attributes attributes)
+                throws SAXException {
+            for (int i = 0; i < attributes.getLength(); i++) {
+                if ("name".equals(attributes.getLocalName(i))) {
+                    char[] chars = attributes.getValue(i).toCharArray();
+                    handler.startElement("", "p", "p", new AttributesImpl());
+                    handler.characters(chars, 0, chars.length);
+                    handler.endElement("", "p", "p");
+                }
+            }
+            switch (localName) {
+                case "Title":
+                    state = STATE.TITLE;
+                    break;
+                case "Author":
+                    state = STATE.AUTHOR;
+                    break;
+                case "Generator":
+                    state = STATE.GENERATOR;
+                    break;
+                case "Created":
+                    state = STATE.CREATED;
+                    break;
+                default:
+                    state = STATE.OTHER;
+            }
+        }
+
+        @Override
+        public void endElement(String uri, String localName, String qName) throws SAXException {
+            switch (state) {
+                case TITLE:
+                    metadata.set(TikaCoreProperties.TITLE, state.getValue());
+                    break;
+                case AUTHOR:
+                    metadata.set(TikaCoreProperties.CREATOR, state.getValue());
+                    break;
+                case GENERATOR:
+                    metadata.set(TikaCoreProperties.CREATOR_TOOL, state.getValue());
+                    break;
+                case CREATED:
+                    metadata.set("dc:created", state.getValue());
+                    break;
+            }
+
+            state = STATE.OTHER;
+        }
+
+        @Override
+        public void characters(char[] ch, int start, int length) throws SAXException {
+            if (!state.equals(STATE.OTHER)) {
+                state.sb.append(ch, start, length);
+            }
+        }
+
+    }
+
+    private static class ManifestHandler extends DefaultHandler {
+        private static String ROOT = "Root";
+        boolean inRoot = false;
+        StringBuilder root = new StringBuilder();
+
+        @Override
+        public void startElement(String uri, String localName, String qName, Attributes attributes)
+                throws SAXException {
+            if (ROOT.equals(localName)) {
+                inRoot = true;
+            }
+        }
+
+        @Override
+        public void endElement(String uri, String localName, String qName) throws SAXException {
+            if (ROOT.equals(localName)) {
+                inRoot = false;
+            }
+        }
+
+        @Override
+        public void characters(char[] ch, int start, int length) throws SAXException {
+            if (inRoot) {
+                root.append(ch, start, length);
+            }
+        }
+
+        private String getRoot() {
+            return root.toString();
+        }
+    }
+}
