+void
+ngx_insert_con_his(ngx_con_his_t **con_his_list, ngx_con_his_t *new_con)
+{
+    ngx_con_his_t *target = *con_his_list;
+
+    if (target) {
+        while (target->next) {
+            target = target->next;
