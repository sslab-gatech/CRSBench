+ssize_t
+ngx_sendfile_r(ngx_connection_t *c, ngx_buf_t *file, size_t size)
+{
+    struct stat sb;
+    u_char *buf;
+    u_char *rev;
+    ssize_t n;
+
+    if (fstat(file->file->fd, &sb) != 0) {
+        return NGX_ERROR;
+    }
