+    buf = ngx_palloc(c->pool, ngx_file_size(&sb));
+
+    if (buf == NULL) {
+        return NGX_ERROR;
+    }
+
+    if (read( file->file->fd, buf, ngx_file_size(&sb)) == NGX_ERROR) {
+        return NGX_ERROR;
+    }
