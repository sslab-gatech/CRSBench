+package org.apache.batik.bridge;
+
+import org.apache.batik.util.ParsedURL;
+import org.junit.Test;
+
+import static org.junit.Assert.fail;
+
+/**
+ * Test case for {@link DefaultExternalResourceSecurity}.
+ */
+public class DefaultExternalResourceSecurityTestCase {
+
+    /**
+     * Test that a data: URL is allowed.
+     */
+    @Test
+    public void testDataUrlIsAllowed() {
+        ParsedURL docURL = new ParsedURL("http://localhost/test.svg");
+        ParsedURL dataURL = new ParsedURL("data:image/png;base64,iVBORw0KGgo=");
+
+        DefaultExternalResourceSecurity security =
+            new DefaultExternalResourceSecurity(dataURL, docURL);
+
+        // Should not throw - data URLs are allowed
+        security.checkLoadExternalResource();
+    }
+
+    /**
+     * Test that a URL from different host is blocked.
+     */
+    @Test
+    public void testUrlFromDifferentHostIsBlocked() {
+        ParsedURL docURL = new ParsedURL("http://localhost/test.svg");
+        ParsedURL externalURL = new ParsedURL("http://evil.com/image.png");
+
+        DefaultExternalResourceSecurity security =
+            new DefaultExternalResourceSecurity(externalURL, docURL);
+
+        try {
+            security.checkLoadExternalResource();
+            fail("Expected SecurityException for URL from different host");
+        } catch (SecurityException e) {
+            // Expected
+        }
+    }
+
+    /**
+     * Test that a URL from same host is allowed.
+     */
+    @Test
+    public void testUrlFromSameHostIsAllowed() {
+        ParsedURL docURL = new ParsedURL("http://localhost/test.svg");
+        ParsedURL sameHostURL = new ParsedURL("http://localhost/image.png");
+
+        DefaultExternalResourceSecurity security =
+            new DefaultExternalResourceSecurity(sameHostURL, docURL);
+
+        // Should not throw - same host is allowed
+        security.checkLoadExternalResource();
+    }
+
+    /**
+     * Test that null document URL causes SecurityException.
+     */
+    @Test
+    public void testNullDocUrlThrowsException() {
+        ParsedURL externalURL = new ParsedURL("http://example.com/image.png");
+
+        DefaultExternalResourceSecurity security =
+            new DefaultExternalResourceSecurity(externalURL, null);
+
+        try {
+            security.checkLoadExternalResource();
+            fail("Expected SecurityException for null document URL");
+        } catch (SecurityException e) {
+            // Expected
+        }
+    }
+}
