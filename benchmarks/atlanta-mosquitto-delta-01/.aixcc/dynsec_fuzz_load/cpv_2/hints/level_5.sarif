{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "unknown-vulnerability",
              "name": "Unknown Vulnerability",
              "shortDescription": {
                "text": "Unknown vulnerability detected"
              },
              "fullDescription": {
                "text": "A vulnerability was detected but no CWE classification is available."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "unknown-vulnerability",
          "level": "warning",
          "message": {
            "text": "Unknown Vulnerability\nVulnerability: MOCK: cpv_2 vulnerability in dynsec_fuzz_load\nDescription: MOCK: Vulnerability cpv_2 detected in harness dynsec_fuzz_load. This vulnerability is detected by address sanitizer. The error signature is: 'AddressSanitizer: heap-use-after-free'.\n\nNOTE: This description is auto-generated from limited metadata in the Team-Atlanta format. For accurate vulnerability details, please analyze the patches, POV blobs, and crash logs."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "path/to/vulnerable/file.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "dynsec_clients__find",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}