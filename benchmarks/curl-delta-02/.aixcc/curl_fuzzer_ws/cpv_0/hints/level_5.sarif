  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-476",
              "name": "CWE-476: NULL Pointer Dereference",
              "shortDescription": {
                "text": "NULL Pointer Dereference"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: NULL Pointer Dereference"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-476",
          "level": "warning",
          "message": {
            "text": "CWE-476 - NULL Pointer Dereference\nVulnerability: curl-006, medium difficulty crash\nDescription: A null pointer dereference exists in the \"totallyfineprotocl\" supported by Curl. It is triggered by the server writing a specific response in the middle of a client connection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/totallyfineprotocl.c"
                },
                "region": {
                  "startLine": 228,
                  "endLine": 232,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "totallyfineprotocl_sm",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
