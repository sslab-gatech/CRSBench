{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-125",
              "name": "CWE-125: Out-of-bounds Read",
              "shortDescription": {
                "text": "Out-of-bounds Read"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Read"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-125",
          "level": "warning",
          "message": {
            "text": "CWE-125 - Out-of-bounds Read\nVulnerability: IPv4 Internet Protocol Options initial code\nDescription: Initial code in mg_tcpip_rx() in net_builtin.c was developed to handle IPv4 Internet Protocol Options. However, the current packet length checks are not sufficient to handle a packet that has an Internet Protocol Option."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/net_builtin.c"
                },
                "region": {
                  "startLine": 801,
                  "endLine": 801,
                  "startColumn": 9,
                  "endColumn": 65
                }
              },
              "logicalLocations": [
                {
                  "name": "rx_icmp",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}