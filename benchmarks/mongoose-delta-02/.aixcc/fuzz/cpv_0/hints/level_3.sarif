{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-125",
              "name": "CWE-125: Out-of-bounds Read",
              "shortDescription": {
                "text": "Out-of-bounds Read"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Read"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-125",
          "level": "warning",
          "message": {
            "text": "CWE-125 - Out-of-bounds Read in function(s): rx_icmp"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/net_builtin.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "rx_icmp",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}