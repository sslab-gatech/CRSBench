  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-416",
              "name": "CWE-416: Use After Free",
              "shortDescription": {
                "text": "Use After Free"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Use After Free"
              }
            },
            {
              "id": "CWE-825",
              "name": "CWE-825: Unknown vulnerability type",
              "shortDescription": {
                "text": "Unknown vulnerability type"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Unknown vulnerability type"
              }
            },
            {
              "id": "CWE-672",
              "name": "CWE-672: Unknown vulnerability type",
              "shortDescription": {
