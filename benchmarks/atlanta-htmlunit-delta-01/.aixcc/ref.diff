+    /**
+     * Tests the behavior of XSLTProcessor with and without the HTMLUNIT_DTD_ALLOWLIST system property.
+     * Verifies that external DTD access is blocked when the property is not set and allowed when it is set.
+     *
+     * @throws Exception if the test fails
+     */
+    @Test
+    @Alerts({
+        "<root/>",
+        "<root>Test Entity Value</root>"
+    })
+    public void testDTDAccess() throws Exception {
+        // Create temporary DTD file
+        File tempDTD = File.createTempFile("test", ".dtd");
+        tempDTD.deleteOnExit();  // Ensure temp file is deleted on exit
+        try (FileWriter writer = new FileWriter(tempDTD)) {
+            writer.write("<!ENTITY testEntity \"Test Entity Value\">");
+        }
+        String dtdUri = tempDTD.toURI().toString();
+
+        // Prepare XSLT that references the DTD
+        String xsl = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+            + "<!DOCTYPE xsl:stylesheet SYSTEM \"" + dtdUri + "\">\n"
+            + "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\">\n"
+            + "  <xsl:template match=\"/\">\n"
+            + "    <root>&testEntity;</root>\n"
+            + "  </xsl:template>\n"
+            + "</xsl:stylesheet>";
+
+        // Prepare XML input
+        String xml = "<root/>";
+
+        // Escape the XSLT and XML strings for JavaScript
+        String xslEscaped = xsl.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n");
+        String xmlEscaped = xml.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n");
+
+        // JavaScript code to perform the transformation
+        String script = LOG_TITLE_FUNCTION
+            + "  function test() {\n"
+            + "    try {\n"
+            + "      var parser = new DOMParser();\n"
+            + "      var xmlDoc = parser.parseFromString(\"" + xmlEscaped + "\", 'application/xml');\n"
+            + "      var xslDoc = parser.parseFromString(\"" + xslEscaped + "\", 'application/xml');\n"
+            + "      var processor = new XSLTProcessor();\n"
+            + "      processor.importStylesheet(xslDoc);\n"
+            + "      var resultDoc = processor.transformToDocument(xmlDoc);\n"
+            + "      log(new XMLSerializer().serializeToString(resultDoc));\n"
+            + "    } catch(e) { log('exception:' + e); }\n"
+            + "  }\n"
+            + "  test();\n";
+
+        // First, without setting the System property
+        System.clearProperty("HTMLUNIT_DTD_ALLOWLIST");
+        String html = "<html><head><script>\n" + script + "\n</script></head><body></body></html>";
+
+        String[] alerts = getExpectedAlerts();
+
+        // Load the page and verify the output
+        setExpectedAlerts(alerts[0]);  // Use the first alert for this run
+        loadPageVerifyTitle2(html);
+
+        // Then, set the System property to allow the DTD URI
+        System.setProperty("HTMLUNIT_DTD_ALLOWLIST", dtdUri);
+
+        // Load the page again and verify the output
+        setExpectedAlerts(alerts[1]);  // Use the second alert for this run
+        loadPageVerifyTitle2(html);
+
+        // Cleanup
+        System.clearProperty("HTMLUNIT_DTD_ALLOWLIST");
+    }
+
+
+}
