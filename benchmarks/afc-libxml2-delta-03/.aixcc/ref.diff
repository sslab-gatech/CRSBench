+static int
+test_UTF32ToUTF8(void) {
+    int test_ret = 0;
+    char* test_str = "AAAA";
+    int in_len=strlen(test_str);
+    int out_len=1024;
+    unsigned char* outb1 = calloc(1,1024);
+    char* outb2 = calloc(1,1024);
+    int r = 0;
+    r = UTF8ToUTF32(outb1, &out_len, (unsigned char*)test_str, &in_len, NULL);
+    if (out_len==0) {
+        test_ret++;
+        in_len = 0;
+    } else {
+        in_len = out_len;
+    }
+    out_len = 1024;
+    r = UTF32ToUTF8((unsigned char*)outb2, &out_len, outb1, &in_len, NULL);
+    if (out_len==0)
+        test_ret++;
+    free(outb1);
+    free(outb2);
+    return(test_ret);
+}
 
