+int
+UTF8ToUTF32(unsigned char *out, int *outlen,
+              const unsigned char *in, int *inlen,
+              void *vctxt ATTRIBUTE_UNUSED) {
+    const unsigned char *instart = in;
+    const unsigned char *inend;
+    unsigned char *outstart = out;
+    unsigned char *outend;
+    unsigned c, d;
+    int ret = XML_ENC_ERR_SPACE;
+    int i, len;
+    /* UTF32 encoding has no BOM */
+    if ((out == NULL) || (outlen == NULL) || (inlen == NULL))
+        return(XML_ENC_ERR_INTERNAL);
+    if (in == NULL) {
+	*outlen = 0;
+	*inlen = 0;
+	return(0);
+    }
+    inend = in + *inlen;
+    outend = out + (*outlen & ~1);
+    while (in < inend) {
+        c = in[0];
+
+        if (c < 0x80) {
+            if (out >= outend)
+                break;
+            out[0] = c;
+            out[1] = 0;
+            out[2] = 0;
+            out[3] = 0;
+            in += 1;
+            out += 4;
+        } else {
+            unsigned min;
+            if (c < 0xE0) {
+                if (c < 0xC2) {
+                    ret = XML_ENC_ERR_INPUT;
+                    break;
+                }
+                c &= 0x1F;
+                len = 2;
+                min = 0x80;
+            } else if (c < 0xF0) {
+                c &= 0x0F;
+                len = 3;
+                min = 0x800;
+            } else {
+                c &= 0x0F;
+                len = 4;
+                min = 0x10000;
+            }
+
+            if (inend - in < len)
+                break;
+
+            for (i = 1; i < len; i++) {
+                if ((in[i] & 0xC0) != 0x80) {
+                    ret = XML_ENC_ERR_INPUT;
+                    break;
+                }
+                c = (c << 6) | (in[i] & 0x3F);
+            }
+
+            if ((c < min) ||
+                ((c >= 0xD800) && (c <= 0xDFFF)) ||
+                (c > 0x10FFFF)) {
+                ret = XML_ENC_ERR_INPUT;
+                break;
+            }
+
+            if (c < 0x10000) {
+                if (out >= outend)
+                    break;
+                out[0] = c & 0xFF;
+                out[1] = c >> 8;
+                out[2] = 0;
+                out[3] = 0;
+                out += 4;
+            } else {
+                if (outend - out < 4)
+                    break;
+                c -= 0x10000;
+                d = (c & 0x03FF) | 0xDC00;
+                c = (c >> 10)    | 0xD800;
+                out[0] = c & 0xFF;
+                out[1] = c >> 8;
+                out[2] = d & 0xFF;
+                out[3] = d >> 8;
+                out += 4;
+            }
+
+            in += len;
+        }
+    }
+
+    if (in-instart > 0)
+        ret = out - outstart;
+
+    *outlen = out - outstart;
+    *inlen = in - instart;
+    return(ret);
+}
+
+int
+UTF32ToUTF8(unsigned char *out, int *outlen,
+              const unsigned char *in, int *inlen,
+              void *vctxt ATTRIBUTE_UNUSED) {
+    const unsigned char *instart = in;
+    const unsigned char *inend = in + (*inlen & ~1);
+    unsigned char *outstart = out;
+    unsigned long int b0, b1, b2, b3, c, d;
+    int ret = XML_ENC_ERR_SPACE;
+
+    if ((in[0] != 0x20) && (in[1] != 0x20) && (in[2] != 0x20) && (in[3] != 0x20)) {
+        /* bom is managed already */
+    }
+
+
+    while (in < inend) {
+        b0 = in[0];
+        b1 = in[1];
+        b1 = (b1 << 0x8);
+        b2 = in[2];
+        b2 = (b2 << 0x10);
+        b3 = in[3];
+        b3 = (b3 << 0x18);
+        c = b0 | b1 | b2 | b3;
+
+        if (c < 0x80) {
+            out[0] = c;
+            in += 4;
+            out += 1;
+        } else if (c < 0x800) {
+            out[0] = (c >> 6)   | 0xC0;
+            out[1] = (c & 0x3F) | 0x80;
+            in += 4;
+            out += 2;
+        } else if ((c & 0xF800) != 0xD800) {
+            out[0] =  (c >> 12)         | 0xE0;
+            out[1] = ((c >>  6) & 0x3F) | 0x80;
+            out[2] =  (c        & 0x3F) | 0x80;
+            in += 4;
+            out += 3;
+        } else {
+            /* Surrogate pair */
+            if ((c & 0xFC00) != 0xD800) {
+                ret = XML_ERR_INTERNAL_ERROR;
+                break;
+            }
+	        if (inend - in < 4)
+		        break;
+            d = in[2] | (in[3] << 8);
+            if ((d & 0xFC00) != 0xDC00) {
+                ret = XML_ERR_INTERNAL_ERROR;
+                break;
+            }
+            /*
+                simplified due to encoding errors encountered with:
+
+                c = (c << 10) + d - ((0xD800 << 10) + 0xDC00 - 0x10000);
+                out[0] =  (c >> 18)         | 0xF0;
+                out[1] = ((c >> 12) & 0x3F) | 0x80;
+                out[2] = ((c >>  6) & 0x3F) | 0x80;
+                out[3] =  (c        & 0x3F) | 0x80;
+            */
+            out[0] = c & 0xff;
+            out[1] = (c >> 8) & 0xff;
+            out[2] = (c >> 0x10) & 0xff;
+            out[3] = (c >> 0x18) & 0xff;
+            in += 4;
+            out += 4;
+        }
+    }
+
+    if (in-instart > 0)
+        ret = out - outstart;
+
+    *outlen = out - outstart;
+    *inlen = in - instart;
+    return(ret);
+}
