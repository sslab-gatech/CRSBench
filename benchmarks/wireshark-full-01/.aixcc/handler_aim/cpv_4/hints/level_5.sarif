    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-121",
              "name": "CWE-121: Stack-based Buffer Overflow",
              "shortDescription": {
                "text": "Stack-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Stack-based Buffer Overflow"
              }
            },
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
