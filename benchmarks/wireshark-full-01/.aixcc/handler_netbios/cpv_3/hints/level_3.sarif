  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow in function(s): dissect_netb_terminate_trace"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "epan/dissectors/packet-netbios.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "dissect_netb_terminate_trace",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
