          "ruleId": "CWE-416",
          "level": "warning",
          "message": {
            "text": "CWE-416 - Use After Free\nVulnerability: wireshark telnet subcommand use-after-free\nDescription: Failure to set pointer variable to NULL and clearing a flag after being freed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "epan/dissectors/packet-telnet.c"
                },
                "region": {
                  "startLine": 2209,
                  "endLine": 2213,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "__asan_memcpy",
                  "kind": "function"
                }
              ]
            }
          ]
        }
