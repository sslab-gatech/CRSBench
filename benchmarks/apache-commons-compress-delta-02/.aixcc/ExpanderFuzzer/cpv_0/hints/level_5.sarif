{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-789",
              "name": "CWE-789: Memory Allocation with Excessive Size Value",
              "shortDescription": {
                "text": "Memory Allocation with Excessive Size Value"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Memory Allocation with Excessive Size Value"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-789",
          "level": "warning",
          "message": {
            "text": "CWE-789 - Memory Allocation with Excessive Size Value\nVulnerability: OOM on crafted compressed file\nDescription: Some compression formats may build large tables in memory before decompressing a file based on information in the compressed file. A very small crafted file may cause a  decompressor to allocate GBs of memory unless a limit is set."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/org/apache/commons/compress/archivers/examples/Expander.java"
                },
                "region": {
                  "startLine": 221,
                  "endLine": 241,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "initializeTables",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}