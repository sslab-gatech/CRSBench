+
+    private class ExtendedPropertiesHandler extends DefaultHandler {
+        private final StringBuilder text;
+        int depth = 0;
+        boolean wroteHeader = false;
+        boolean inAppVersion = false;
+        StringBuilder appVersionBuffer = new StringBuilder();
+        public ExtendedPropertiesHandler(StringBuilder text) {
+            this.text = text;
+        }
+
+        @Override
+        public void startElement(String uri, String localName, String qName, Attributes attributes) throws SAXException {
+            if (depth == 1) {
+                if (! wroteHeader) {
+                    text.append("Extended Properties:\n");
+                    wroteHeader = true;
+                }
+                text.append(qName.trim()).append(": ");
+            }
+            if ("AppVersion".equals(qName)) {
+                inAppVersion = true;
+            }
+            depth++;
+        }
+
+        @Override
+        public void endElement(String uri, String localName, String qName) throws SAXException {
+            depth--;
+            if (depth == 1) {
+                text.append("\n");
+            } else {
+                text.append(" ");
+            }
+            if ("AppVersion".equals(qName)) {
+                handleAppVersion();
+                inAppVersion = false;
+            }
+        }
+
+        private void handleAppVersion() {
+            String appVersionString = appVersionBuffer.toString();
+            if (appVersionString.isEmpty()) {
+                return;
+            }
+            Matcher m = MAJOR_VERSION_PATTERN.matcher(appVersionString);
+            if (m.find()) {
+                text.append("MajorVersion: ").append(m.group(1)).append("\n");
+            }
+            appVersionBuffer.setLength(0);
+        }
+
+        @Override
+        public void characters(char[] ch, int start, int length) throws SAXException {
+            text.append(ch, start, length);
+            if (inAppVersion) {
+                appVersionBuffer.append(ch, start, length);
+            }
+        }
+    }
 }
