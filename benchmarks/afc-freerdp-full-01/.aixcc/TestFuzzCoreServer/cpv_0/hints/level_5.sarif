{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-190",
              "name": "CWE-190: Integer Overflow or Wraparound",
              "shortDescription": {
                "text": "Integer Overflow or Wraparound"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Integer Overflow or Wraparound"
              }
            },
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-190",
          "level": "warning",
          "message": {
            "text": "CWE-190 - Integer Overflow or Wraparound\nVulnerability: FreeRDP Integer Overflow\nDescription: Changing a integer from unsigned to signed causes vulnerabilities from attacker specified data due to implicit C integer promotion issues, causing a heap buffer overflow"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libfreerdp/core/mcs.h"
                },
                "region": {
                  "startLine": 147,
                  "endLine": 147,
                  "startColumn": 5,
                  "endColumn": 22
                }
              },
              "logicalLocations": [
                {
                  "name": "Stream_Read",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow\nVulnerability: FreeRDP Integer Overflow\nDescription: Changing a integer from unsigned to signed causes vulnerabilities from attacker specified data due to implicit C integer promotion issues, causing a heap buffer overflow"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libfreerdp/core/mcs.h"
                },
                "region": {
                  "startLine": 147,
                  "endLine": 147,
                  "startColumn": 5,
                  "endColumn": 22
                }
              },
              "logicalLocations": [
                {
                  "name": "Stream_Read",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}