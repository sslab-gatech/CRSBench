                "text": "Buffer Over-read"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Buffer Over-read"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-126",
          "level": "warning",
          "message": {
            "text": "CWE-126 - Buffer Over-read in function(s): json_parse_ex"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/json.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "json_parse_ex",
                  "kind": "function"
                }
              ]
