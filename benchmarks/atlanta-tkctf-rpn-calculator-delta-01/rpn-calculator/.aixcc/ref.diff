+    char in;
+    // reset global variables
+    reset_globals();
+    // buffers for strings
+    A a = {0};
+    a.idx = START;
+    wchar_t *wcs = (wchar_t *)a.values;
+    int *values = a.values;
+    char tmpbuf[32];
+    for (;;) {
+        r2 = scanf("%31s", tmpbuf);
+        if (r2 == EOF) { return; }
+        r2 = sscanf(tmpbuf, "%i", &r1);
+        if (r2 != 0) {
+            check_value( push(values, &a.idx, r1), 
+                    "Push: ran out of stack space" );
+            continue;
+        }
+        in = tmpbuf[0];
+        switch (in) {
+            case EOF: // end of input
+            case 'q':
+                return;
+            // TODO implement commutative recursive operation
+            case '+': // add
+                two_arg_operand( r3 = r1 + r2, a );
+                break;
+            case '-': // subtract
+                two_arg_operand( r3 = r1 - r2, a );
+                break;
+            case '/': // divide
+                two_arg_operand( r3 = r1 / r2, a );
+                break; 
+            case '*': // multiply
+                two_arg_operand( r3 = r1 * r2, a );
+                break;
+            case '%': // mod
+                two_arg_operand( r3 = r1 % r2, a );
+                break;
+            case '|': // bit or
+                two_arg_operand( r3 = r1 | r2, a );
+                break;
+            case '&': // bit and
+                two_arg_operand( r3 = r1 & r2, a );
+                break;
+            case '^': // bit xor
+                two_arg_operand( r3 = r1 ^ r2, a );
+                break;
+            case '~': // bit not
+                one_arg_operand( r3 = ~r1, a );
+                break;
+            case 'r': // return
+                check_value( ret(values, &a.idx),
+                             "Return pop: no more elements on stack" );
+                break;
+            case 't': // dump top of stack
+                dump(values, a.idx - 1);
+                break;
+            case 'c': // clear stack
+                a.idx = START;
+                break;
+            case 'p': // print
+                in = tmpbuf[1];
+                if ( in == 'd' || in == '\t' || in == '\n' ||
+                     in == ' ' || in == '\r' || in == EOF || in == 0 )
+                {
+                    for (int i = a.idx - 1; i >= START; i--) {
+                        dump(values, i);
+                    }
+                }
+                else if ( in == 'x' ) {
+                    for (int i = a.idx - 1; i >= START; i--) {
+                        r1 = values[i];
+                        unsigned char *bytes = (unsigned char*)&r1;
+                        for (int i = sizeof(r1) - 1; i >= 0; i--) {
+                            printf("%02X ", bytes[i]);
+                        }
+                        printf("\n");
+                    }
+                }
+                else if ( in == 'w' ) {
+                    // leave START - 1 as null byte to catch the first word on stack
+                    int widx = CHILD_SIZE - 2;
+                    for ( int i = a.idx - 1; 
+                          (wchar_t)values[i] != 0; 
+                          i--, widx-- ) 
+                    { 
+                        wcs[widx] = (wchar_t)values[i];
+                    }
+                    print_utf8(wcs + widx + 1); // start at the last copied value
+                }
+                else if ( in == 's' ) {
+                    const int max = CHILD_SIZE;
+                    bool intermediate = false;
+                    int save = 0;
+                    for (int i = max - 1; i >= 0; i--) {
+                        wcs[i] = (wchar_t)(values + START)[i];
+                        // print intermediate null chars as period
+                        if (intermediate && wcs[i] == 0) {
+                            wcs[i] = '.';
+                        }
+                        else if (!intermediate && wcs[i] != 0) {
+                            intermediate = true;
+                            save = i + 1;
+                        }
+                    }
+                    print_utf8(wcs);
+                }
+                break;
+            case '\t': // whitespace nop
+            case '\n':
+            case '\r':
+            case ' ':
+                break;
+            default:
+                printf("Invalid operand %c\n", in);
+                return;
+        }
