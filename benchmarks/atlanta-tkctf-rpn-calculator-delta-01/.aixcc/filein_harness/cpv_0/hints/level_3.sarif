              "shortDescription": {
                "text": "Unknown vulnerability type"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Unknown vulnerability type"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write in function(s): main_loop"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cp-tkctf-rpn-calculator-source/stackmachine.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "main_loop",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-125",
          "level": "warning",
          "message": {
            "text": "CWE-125 - Out-of-bounds Read in function(s): main_loop"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cp-tkctf-rpn-calculator-source/stackmachine.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "main_loop",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-823",
          "level": "warning",
          "message": {
            "text": "CWE-823 - Unknown vulnerability type in function(s): main_loop"
          },
          "locations": [
            {
