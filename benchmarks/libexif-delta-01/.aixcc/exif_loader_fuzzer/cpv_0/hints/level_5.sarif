{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow\nVulnerability: exif-003, apple mnote bug 1\nDescription: An out of bounds read in the indentification code leads to a heap-based buffer overflow."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libexif/apple/exif-mnote-data-apple.c"
                },
                "region": {
                  "startLine": 236,
                  "endLine": 247,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "strcmp",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}