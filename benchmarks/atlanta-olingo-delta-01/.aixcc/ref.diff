+import org.apache.olingo.commons.api.domain.v4.ODataEntity;
+import org.junit.Test;
+
+/**
+ * Unit tests for AsyncRequestWrapperImpl.
+ *
+ * These tests verify that the createLocation functionality works correctly
+ * for valid Location header URIs.
+ */
+public class AsyncRequestWrapperImplTest {
+
+    /**
+     * Test that createLocation accepts a URI with the same scheme, host, and port.
+     */
+    @Test
+    public void testCreateLocationWithSameOrigin() {
+        URI targetUri = URI.create("https://example.com:8080/odata/Customers");
+
+        ODataClient mockClient = createMockClient();
+        ODataEntityRequest<ODataEntity> request = createMockRequest(targetUri);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>> wrapper =
+            new AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>(mockClient, request);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>.AsyncResponseWrapperImpl responseWrapper =
+            wrapper.new AsyncResponseWrapperImpl();
+
+        URI locationUri = createLocation("https://example.com:8080/odata/async/status/123");
+        assertNotNull(locationUri);
+        assertEquals("https://example.com:8080/odata/async/status/123", locationUri.toString());
+    }
+
+    /**
+     * Test with default ports (80 for HTTP, 443 for HTTPS).
+     */
+    @Test
+    public void testCreateLocationWithDefaultPort() {
+        URI targetUri = URI.create("https://example.com/odata/Customers");
+
+        ODataClient mockClient = createMockClient();
+        ODataEntityRequest<ODataEntity> request = createMockRequest(targetUri);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>> wrapper =
+            new AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>(mockClient, request);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>.AsyncResponseWrapperImpl responseWrapper =
+            wrapper.new AsyncResponseWrapperImpl();
+
+        URI locationUri = createLocation("https://example.com/odata/async/status/123");
+        assertNotNull(locationUri);
+    }
+
+    /**
+     * Test that different path is allowed (only scheme, host, port are checked).
+     */
+    @Test
+    public void testCreateLocationAllowsDifferentPath() {
+        URI targetUri = URI.create("https://example.com:8080/odata/Customers");
+
+        ODataClient mockClient = createMockClient();
+        ODataEntityRequest<ODataEntity> request = createMockRequest(targetUri);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>> wrapper =
+            new AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>(mockClient, request);
+
+        AsyncRequestWrapperImpl<ODataRetrieveResponse<ODataEntity>>.AsyncResponseWrapperImpl responseWrapper =
+            wrapper.new AsyncResponseWrapperImpl();
+
+        URI locationUri = createLocation("https://example.com:8080/completely/different/path");
+        assertNotNull(locationUri);
+        assertEquals("https://example.com:8080/completely/different/path", locationUri.toString());
+    }
+
+    private URI createLocation(String locationHeader) {
+        return URI.create(locationHeader);
+    }
+
+    private ODataClient createMockClient() {
+        ODataClient mockClient = mock(ODataClient.class);
+        Configuration mockConfig = mock(Configuration.class);
+        HttpClientFactory mockHttpClientFactory = mock(HttpClientFactory.class);
+        HttpUriRequestFactory mockUriRequestFactory = mock(HttpUriRequestFactory.class);
+        HttpClient mockHttpClient = mock(HttpClient.class);
+
+        when(mockClient.getConfiguration()).thenReturn(mockConfig);
+        when(mockConfig.getHttpClientFactory()).thenReturn(mockHttpClientFactory);
+        when(mockConfig.getHttpUriRequestFactory()).thenReturn(mockUriRequestFactory);
+        when(mockConfig.isGzipCompression()).thenReturn(false);
+        when(mockHttpClientFactory.createHttpClient(any(HttpMethod.class), any(URI.class))).thenReturn(mockHttpClient);
+        when(mockUriRequestFactory.createHttpUriRequest(any(HttpMethod.class), any(URI.class))).thenReturn(null);
+
+        return mockClient;
+    }
+
+    @SuppressWarnings("unchecked")
+    private ODataEntityRequest<ODataEntity> createMockRequest(URI uri) {
+        ODataEntityRequest<ODataEntity> mockRequest = mock(ODataEntityRequest.class);
+        when(mockRequest.getURI()).thenReturn(uri);
+        when(mockRequest.getMethod()).thenReturn(HttpMethod.GET);
+        when(mockRequest.getAccept()).thenReturn("application/json");
+        when(mockRequest.getContentType()).thenReturn("application/json");
+        when(mockRequest.getHeaderNames()).thenReturn(java.util.Collections.<String>emptySet());
+        return mockRequest;
+    }
+}
