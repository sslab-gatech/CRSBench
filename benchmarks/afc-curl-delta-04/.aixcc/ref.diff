+#include "curl_setup.h"
+
+#ifdef HAVE_NETINET_IN_H
+#include <netinet/in.h>
+#endif
+#ifdef HAVE_NETDB_H
+#include <netdb.h>
+#endif
+#ifdef HAVE_ARPA_INET_H
+#include <arpa/inet.h>
+#endif
+#ifdef HAVE_NET_IF_H
+#include <net/if.h>
+#endif
+#ifdef HAVE_SYS_IOCTL_H
+#include <sys/ioctl.h>
+#endif
+
+#ifdef HAVE_SYS_PARAM_H
+#include <sys/param.h>
+#endif
+
+#ifdef HAVE_SYS_SELECT_H
+#include <sys/select.h>
+#elif defined(HAVE_UNISTD_H)
+#include <unistd.h>
+#endif
+
+#include "urldata.h"
+#include <curl/curl.h>
+#include "transfer.h"
+#include "sendf.h"
+#include "escape.h"
+#include "progress.h"
+#include "extremelygoodprtcl.h"
+#include "curl_printf.h"
+#include "strcase.h"
+#include "curl_memory.h"
+/* The last #include file should be: */
+#include "memdebug.h"
+#include "curl_md5.h"
+
+#include "curl_base64.h"
+#include <openssl/conf.h>
+#include <openssl/evp.h>
+#include <openssl/err.h>
+
+int encrypt(unsigned char *plaintext, int plaintext_len, unsigned char *key,
+            unsigned char *iv, unsigned char *ciphertext)
+{
+    EVP_CIPHER_CTX *ctx;
+
+    int len;
+
+    int ciphertext_len;
+
+    /* Create and initialise the context */
+    ctx = EVP_CIPHER_CTX_new();
+    if(!ctx)
+      return -1;
+
+    /*
+     * Initialise the encryption operation. IMPORTANT - ensure you use a key
+     * and IV size appropriate for your cipher
+     * In this example we are using 256 bit AES (i.e. a 256 bit key). The
+     * IV size for *most* modes is the same as the block size. For AES this
+     * is 128 bits
+     */
+    if(1 != EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, key, iv))
+      return -1;
+
+    /*
+     * Provide the message to be encrypted, and obtain the encrypted output.
+     * EVP_EncryptUpdate can be called multiple times if necessary
+     */
+    if(1 != EVP_EncryptUpdate(ctx, ciphertext, &len, plaintext, plaintext_len))
+      return -1;
+    ciphertext_len = len;
+
+    /*
+     * Finalise the encryption. Further ciphertext bytes may be written at
+     * this stage.
+     */
+    if(1 != EVP_EncryptFinal_ex(ctx, ciphertext + len, &len))
+      return -1;
+    ciphertext_len += len;
+
+    /* Clean up */
+    EVP_CIPHER_CTX_free(ctx);
+
+    return ciphertext_len;
+}
+
+
+
+/*
+ * Forward declarations.
+ */
+
+
+static bool vnormal_endofresp
+  (struct Curl_easy *data, struct connectdata *conn,
+                          char *line, size_t len, int *code)
+{
+  (void)data;
+  (void)conn;
+
+  return TRUE;
+}
+
+
+static CURLcode extremelygoodprtcl_done(struct Curl_easy *data,
+                          CURLcode status, bool premature)
+{
+  struct extremelygoodprtcl_conn *vnormal = &(data->conn->proto.vnormal);
+  free(vnormal->state1);
+  Curl_pp_disconnect(&vnormal->pp);
+  return CURLE_OK;
+}
+
+static CURLcode extremelygoodprtcl_do_more(struct Curl_easy *data, int *c)
+{
+  *c = -1;
+  return CURLE_OK;
+}
+
+static CURLcode extremelygoodprtcl_do(struct Curl_easy *data, bool *done);
+static CURLcode extremelygoodprtcl_doing(struct Curl_easy *data, bool *done);
+static CURLcode extremelygoodprtcl_sm
+  (struct Curl_easy *data, struct connectdata *conn);
+
+static CURLcode extremelygoodprtcl_conn
+                                (struct Curl_easy *data,
+                                bool *done)
+{
+  *done = FALSE;
+  struct extremelygoodprtcl_conn *vnormal = &(data->conn->proto.vnormal);
+  struct pingpong *pp = &(data->conn->proto.vnormal.pp);
+  struct connectdata *conn = data->conn;
+  PINGPONG_SETUP(pp, extremelygoodprtcl_sm, vnormal_endofresp);
+  Curl_pp_init(pp);
+  vnormal->state1 = calloc(1, 256);
+  return Curl_pp_statemach(data, pp, FALSE, FALSE);
+}
+
+/*
+ * extremelygoodprtcl protocol handler.
+ */
+
+const struct Curl_handler Curl_handler_extremelygoodprtcl = {
+  "extremelygoodprtcl",                             /* scheme */
+  ZERO_NULL,                    /* setup_connection */
+  extremelygoodprtcl_do,                            /* do_it */
+  extremelygoodprtcl_done,                          /* done */
+  extremelygoodprtcl_doing,                          /* do_more */
+  extremelygoodprtcl_conn,                          /* connect_it */
+  extremelygoodprtcl_doing,                          /* connecting */
+  extremelygoodprtcl_doing,                         /* doing */
+  ZERO_NULL,                          /* proto_getsock */
+  ZERO_NULL,                       /* doing_getsock */
+  ZERO_NULL,                          /* domore_getsock */
+  ZERO_NULL,                          /* perform_getsock */
+  ZERO_NULL,                          /* disconnect */
+  ZERO_NULL,                          /* write_resp */
+  ZERO_NULL,                          /* write_resp_hd */
+  ZERO_NULL,                          /* connection_check */
+  ZERO_NULL,                          /* attach connection */
+  PORT_VERYNORMAL,                          /* defport */
+  CURLPROTO_VERYNORMAL,                     /* protocol */
+  CURLPROTO_VERYNORMAL,                     /* family */
+  PROTOPT_NONE                        /* flags */
+};
+
+static CURLcode extremelygoodprtcl_do(struct Curl_easy *data, bool *done)
+{
+  *done = FALSE; /* unconditionally */
+
+  return CURLE_OK;
+}
+
+/* The only way to change state */
+static void vnstate(struct Curl_easy *data,
+                    enum extremelygoodprtclstate state)
+{
+  struct connectdata *conn = data->conn;
+  struct extremelygoodprtcl_conn *vnormal = &conn->proto.vnormal;
+#ifdef DEBUGBUILD
+  infof(data, "%d (from %d)",
+        state,
+        vnormal->state);
+#endif
+  vnormal->state = state;
+}
+
+static CURLcode extremelygoodprtcl_sm
+  (struct Curl_easy *data, struct connectdata *conn)
+{
+  CURLcode result = CURLE_OK;
+  ssize_t nread;
+  struct extremelygoodprtcl_conn *vnormal = &conn->proto.vnormal;
+  const char *done_statement = "All done!";
+  int code;
+
+  result = Curl_pp_readresp(data, 0, &data->conn->proto.vnormal.pp,
+    &code, &nread);
+  char * const response = Curl_dyn_ptr(&data->conn->proto.vnormal.pp.recvbuf);
+
+  infof(data, "extremelygoodprtcl_doing: state [%d]", (int) vnormal->state);
+  /* Get funky with the input data. Permute it over time
+  *  and eventually accept */
+  switch(vnormal->state) {
+    case EXTREMELYGOODPRTCL_STOP:
+      result = CURLE_OK;
+      break;
+    case EXTREMELYGOODPRTCL_START:
+      if(result)
+        break;
+      else if(!nread) {
+        failf(data, "Connection disconnected");
+        result = CURLE_RECV_ERROR;
+        break;
+      }
+      else if(nread != 128) {
+        result = CURLE_WEIRD_SERVER_REPLY;
+        break;
+      }
+      /* A 256 bit key */
+      unsigned char key[] = { 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
+                            0x38, 0x39, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35,
+                            0x36, 0x37, 0x38, 0x39, 0x30, 0x31, 0x32, 0x33,
+                            0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x30, 0x31
+                          };
+
+      /* A 128 bit IV */
+      unsigned char iv[] = { 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
+                            0x38, 0x39, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35
+                          };
+
+      /*
+      * Buffer for ciphertext. Ensure the buffer is long enough for the
+      * ciphertext which may be longer than the plaintext, depending on the
+      * algorithm and mode.
+      */
+      unsigned char ciphertext[256];
+
+      int ciphertext_len;
+
+      /* Encrypt the plaintext */
+      ciphertext_len = encrypt(response, strlen(response), &key, &iv,
+                                ciphertext);
+
+      char *base64;
+      size_t b64len;
+      Curl_base64_encode(ciphertext, ciphertext_len, &base64, &b64len);
+      strcpy(vnormal->state1, base64);
+      vnormal->state1_len = b64len;
+      Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", base64);
+      free(base64);
+      vnstate(data, EXTREMELYGOODPRTCL_DO1);
+      break;
+    case EXTREMELYGOODPRTCL_DO1:
+      if(result || !nread)
+        break;
+      if(strncmp(vnormal->state1, response, vnormal->state1_len) == 0) {
+        vnstate(data, EXTREMELYGOODPRTCL_DO2);
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", "OK\r\n");
+      }
+      else {
+        result = CURLE_WEIRD_SERVER_REPLY;
+      }
+      break;
+    case EXTREMELYGOODPRTCL_DO2:
+      if(result || !nread)
+        break;
+      if(strcasecmp("complete\r\n", response) == 0) {
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", "OK\r\n");
+        result = CURLE_OK;
+        vnstate(data, EXTREMELYGOODPRTCL_STOP);
+      }
+      else if(strcasecmp(response, "crashycrashy\r\n") == 0) {
+        *(unsigned int *)result = CURLE_OK;
+      }
+      else {
+        result = CURLE_WEIRD_SERVER_REPLY;
+      }
+      break;
+    default:
+      result = CURLE_WEIRD_SERVER_REPLY;
+      break;
+  }
+
+
+  if(result == CURLE_AGAIN)
+    result = CURLE_OK;
+  return result;
+}
+
+static CURLcode extremelygoodprtcl_doing(struct Curl_easy *data, bool *done)
+{
+  struct connectdata *conn = data->conn;
+  struct extremelygoodprtcl_conn *vnormal = &conn->proto.vnormal;
+
+  CURLcode result = Curl_pp_statemach(data, &vnormal->pp, FALSE, FALSE);
+
+  *done = (vnormal->state == EXTREMELYGOODPRTCL_STOP);
+
+  return result;
+
+}
