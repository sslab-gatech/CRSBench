+static void canonicalize_string_to_ascii(char *src, char *dst)
+{
+    char *end = src + strlen(src);
+
+    while (src < end) {
+        unsigned char c = (unsigned char)*src;
+
+        if (c < 0x80) {
+            *dst++ = *src++;
+        }
+        else {
+            unsigned int cp = 0;
+            int len = 1;
+
+            if ((c & 0xE0) == 0xC0 && src + 1 < end) {
+                cp  = ((src[0] & 0x1F) << 6)
+                    |  (src[1] & 0x3F);
+                len = 2;
+            }
+            else if ((c & 0xF0) == 0xE0 && src + 2 < end) {
+                cp  = ((src[0] & 0x0F) << 12)
+                    | ((src[1] & 0x3F) <<  6)
+                    |  (src[2] & 0x3F);
+                len = 3;
+            }
+            else if ((c & 0xF8) == 0xF0 && src + 3 < end) {
+                cp  = ((src[0] & 0x07) << 18)
+                    | ((src[1] & 0x3F) << 12)
+                    | ((src[2] & 0x3F) <<  6)
+                    |  (src[3] & 0x3F);
+                len = 4;
+            }
+            else {
+                src++;
+                continue;
+            }
+
+            switch (cp) {
+                case 0x00DF: // ß
+                    *dst++ = 's';
+                    *dst++ = 's';
+                    break;
+                case 0x00E6: // æ
+                    *dst++ = 'a';
+                    *dst++ = 'e';
+                    break;
+                case 0x00E4: // ä
+                    *dst++ = 'a';
+                    *dst++ = 'e';
+                    break;
+                case 0x00F6: // ö
+                    *dst++ = 'o';
+                    *dst++ = 'e';
+                    break;
+                case 0x00FC: // ü
+                    *dst++ = 'u';
+                    *dst++ = 'e';
+                    break;
+                case 0x00F1: // ñ
+                    *dst++ = 'n';
+                    break;
+                case 0x00D1: // Ñ
+                    *dst++ = 'N';
+                    break;
+                case 0x20AC: // €
+                    *dst++ = 'E';
+                    *dst++ = 'U';
+                    *dst++ = 'R';
+                    break;
+                case 0x03B1: // α
+                    *dst++ = 'a';
+                    break;
+                case 0x03B2: // β
+                    *dst++ = 'b';
+                    break;
+                case 0x03C0: // π
+                    *dst++ = 'p';
+                    *dst++ = 'i';
+                    break;
+                case 0x03C6: // φ
+                    *dst++ = 'p';
+                    *dst++ = 'h';
+                    *dst++ = 'i';
+                    break;
+                case 0x03C8: // ψ
+                    *dst++ = 'p';
+                    *dst++ = 's';
+                    *dst++ = 'i';
+                    break;
+                case 0x2026: // … (ellipsis)
+                    *dst++ = '.';
+                    *dst++ = '.';
+                    *dst++ = '.';
+                    break;
+                default:
+                    if (cp < 0x80) {
+                        *dst++ = (char)cp;
+                    } else if (cp < 0x100) {
+                        *dst++ = (char)(cp & 0x7F);
+                    } else {
+                        *dst++ = '?';
+                    }
+            }
+            src += len;
+        }
+    }
+
+    *dst = '\0';
+}
