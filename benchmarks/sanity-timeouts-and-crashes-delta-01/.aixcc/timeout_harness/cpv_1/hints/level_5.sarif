{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-119",
              "name": "CWE-119: Improper Restriction of Operations within the Bounds of a Memory Buffer",
              "shortDescription": {
                "text": "Improper Restriction of Operations within the Bounds of a Memory Buffer"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Improper Restriction of Operations within the Bounds of a Memory Buffer"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write\nVulnerability: Global Buffer Overflow via Unchecked Array Index in mock_vp.c\nDescription: A global buffer overflow vulnerability exists in both func_a and func_b functions\nin mock_vp.c. The functions read two integers from untrusted input: 'num' and 'index'.\nWhen num * 0x1337 equals 24201480 (satisfied when num = 4920), the code writes to\ng_buf[index] without validating that index is within the valid range of the 10-byte\nglobal buffer (indices 0-9). An attacker can craft input with num = 4920 and index >= 10\nto trigger an out-of-bounds write, causing memory corruption, potential code execution,\nor denial of service. The POV demonstrates this with index = 11, writing 2 bytes beyond\nthe allocated buffer.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 14
                }
              },
              "logicalLocations": [
                {
                  "name": "func_a",
                  "kind": "function"
                }
              ]
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 29,
                  "endLine": 29
                }
              },
              "logicalLocations": [
                {
                  "name": "func_b",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-119",
          "level": "warning",
          "message": {
            "text": "CWE-119 - Improper Restriction of Operations within the Bounds of a Memory Buffer\nVulnerability: Global Buffer Overflow via Unchecked Array Index in mock_vp.c\nDescription: A global buffer overflow vulnerability exists in both func_a and func_b functions\nin mock_vp.c. The functions read two integers from untrusted input: 'num' and 'index'.\nWhen num * 0x1337 equals 24201480 (satisfied when num = 4920), the code writes to\ng_buf[index] without validating that index is within the valid range of the 10-byte\nglobal buffer (indices 0-9). An attacker can craft input with num = 4920 and index >= 10\nto trigger an out-of-bounds write, causing memory corruption, potential code execution,\nor denial of service. The POV demonstrates this with index = 11, writing 2 bytes beyond\nthe allocated buffer.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 14
                }
              },
              "logicalLocations": [
                {
                  "name": "func_a",
                  "kind": "function"
                }
              ]
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 29,
                  "endLine": 29
                }
              },
              "logicalLocations": [
                {
                  "name": "func_b",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}