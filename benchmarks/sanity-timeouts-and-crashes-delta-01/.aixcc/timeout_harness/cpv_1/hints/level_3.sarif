{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-119",
              "name": "CWE-119: Improper Restriction of Operations within the Bounds of a Memory Buffer",
              "shortDescription": {
                "text": "Improper Restriction of Operations within the Bounds of a Memory Buffer"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Improper Restriction of Operations within the Bounds of a Memory Buffer"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write in function(s): func_a, func_b"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "func_a",
                  "kind": "function"
                }
              ]
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "func_b",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-119",
          "level": "warning",
          "message": {
            "text": "CWE-119 - Improper Restriction of Operations within the Bounds of a Memory Buffer in function(s): func_a, func_b"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "func_a",
                  "kind": "function"
                }
              ]
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "func_b",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}