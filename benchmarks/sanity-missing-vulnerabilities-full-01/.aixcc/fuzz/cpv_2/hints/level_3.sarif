{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-131",
              "name": "CWE-131: Unknown vulnerability type",
              "shortDescription": {
                "text": "Unknown vulnerability type"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Unknown vulnerability type"
              }
            },
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-120",
              "name": "CWE-120: Buffer Copy without Checking Size of Input ('Classic Buffer Overflow')",
              "shortDescription": {
                "text": "Buffer Copy without Checking Size of Input ('Classic Buffer Overflow')"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Buffer Copy without Checking Size of Input ('Classic Buffer Overflow')"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-131",
          "level": "warning",
          "message": {
            "text": "CWE-131 - Unknown vulnerability type in function(s): set_username"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "user.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "set_username",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write in function(s): set_username"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "user.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "set_username",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-120",
          "level": "warning",
          "message": {
            "text": "CWE-120 - Buffer Copy without Checking Size of Input ('Classic Buffer Overflow') in function(s): set_username"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "user.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "set_username",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}