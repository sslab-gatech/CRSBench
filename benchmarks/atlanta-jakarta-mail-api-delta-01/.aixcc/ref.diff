+        LogRecord r1 = new LogRecord(Level.INFO, Level.INFO.toString());
+        LogRecord r2 = new LogRecord(Level.INFO, Level.INFO.toString());
+
+        r1.setThrown(iioe);
+        r2.setThrown(cli);
+        assertRecordLessThan(r1, r2);
+
+        r1.setThrown(cli);
+        r2.setThrown(iioe);
+        assertRecordLessThan(r2, r1);
+    }
