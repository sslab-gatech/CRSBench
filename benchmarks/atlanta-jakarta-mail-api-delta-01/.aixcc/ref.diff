+                if (line.startsWith("*"))
+                    continue;
+                if (line.contains(expect))
+                    found = true;
+            }
+            r.close();
+            return found;
+        } catch (final Exception e) {
+            e.printStackTrace();
+            fail(e.getMessage());
+            return false;    // XXX - doesn't matter
+        } finally {
+            if (server != null) {
+                server.quit();
+            }
+        }
+    }
