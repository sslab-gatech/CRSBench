+        IMAPProtocol p = null;
+        Status status = null;
+
+        try {
+            p = getStoreProtocol();    // XXX
+            if (!p.hasCapability("CONDSTORE"))
+                throw new BadCommandException("CONDSTORE not supported");
+            String[] item = {"HIGHESTMODSEQ"};
