+                            osgi.serviceloader;
+                              osgi.serviceloader="jakarta.mail.util.StreamProvider",
+                            osgi.serviceloader;
+                              osgi.serviceloader="jakarta.mail.Provider",
+                            ]]>
+                        </Provide-Capability>
+                    </instructions>
+                </configuration>
+            </plugin>
+            <plugin>
+                <groupId>org.apache.maven.plugins</groupId>
+                <artifactId>maven-surefire-plugin</artifactId>
+                <configuration>
