+                            untagged("1 FETCH (BODYSTRUCTURE (" +
+                                    "(\"text\" \"plain\" (\"charset\" \"us-ascii\") " +
+                                    "NIL NIL \"7bit\" 0 0 NIL NIL NIL NIL)" +
