diff --git a/core/src/main/java/org/eclipse/angus/mail/util/PropUtil.java b/core/src/main/java/org/eclipse/angus/mail/util/PropUtil.java
new file mode 100644
index 0000000000000000000000000000000000000000..21b27729ddbc073959bf7a977c76dcb123922985
--- /dev/null
+++ b/core/src/main/java/org/eclipse/angus/mail/util/PropUtil.java
@@ -0,0 +1,194 @@
+/*
