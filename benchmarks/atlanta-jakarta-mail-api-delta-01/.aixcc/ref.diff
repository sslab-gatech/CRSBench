index 0000000000000000000000000000000000000000..b3d8da6b2a64d8d60bb2a609e2e4cd7a6cf4b55b
--- /dev/null
+++ b/providers/imap/src/main/java/org/eclipse/angus/mail/imap/protocol/Namespaces.java
@@ -0,0 +1,152 @@
+/*
