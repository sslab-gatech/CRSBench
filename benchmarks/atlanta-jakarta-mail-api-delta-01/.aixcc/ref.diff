+
+        for (int r = MAX_RUNS; r > 0; r--) {
+            //Null is higher than normal so we have to start at one.
+            for (int i = 1; i <= MAX_LEN; i++) {
+                testByThrownLenSeq(InterruptedException.class, i, r);
