+            newCapacity = capacity;
+        }
+        assert len != capacity : len;
+        final LogRecord[] d = Arrays.copyOf(data, newCapacity, LogRecord[].class);
+        final int[] m = Arrays.copyOf(matched, newCapacity);
+        //Ensure both arrays are created before assigning.
+        this.data = d;
+        this.matched = m;
