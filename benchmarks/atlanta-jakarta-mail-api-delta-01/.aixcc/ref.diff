+    private static abstract class IMAPHandlerIdle extends IMAPHandler {
+        @Override
+        public void select(String line) throws IOException {
+            numberOfMessages = 1;
+            super.select(line);
+        }
+
+        public abstract void waitForIdle() throws InterruptedException;
+    }
