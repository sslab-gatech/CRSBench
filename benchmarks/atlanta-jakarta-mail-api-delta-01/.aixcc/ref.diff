+            port = store.getPort(this);
+            Status s = port.stat();
+            total = s.total;
+            size = s.size;
+            this.mode = mode;
+            if (store.useFileCache) {
+                try {
+                    fileCache = new TempFile(store.fileCacheDir);
+                } catch (IOException ex) {
+                    logger.log(Level.FINE, "failed to create file cache", ex);
+                    throw ex;    // caught below
+                }
+            }
