+            throws MessagingException {
+        InputStream rawcontent = null;
+        try {
+            synchronized (this) {
+                rawcontent = rawData.get();
+                if (rawcontent == null) {
+                    TempFile cache = folder.getFileCache();
+                    if (cache != null) {
+                        if (folder.logger.isLoggable(Level.FINE))
+                            folder.logger.fine("caching message #" + msgnum +
+                                    " in temp file");
