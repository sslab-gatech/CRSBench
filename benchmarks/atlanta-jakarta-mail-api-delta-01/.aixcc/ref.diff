+        int left = line.lastIndexOf('{');
+        int right = line.indexOf('}', left);
+        int bytes = Integer.parseInt(line.substring(left + 1, right));
+        cont("waiting for message");
+        collectMessage(bytes);
+        ok();    // XXX
+    }
