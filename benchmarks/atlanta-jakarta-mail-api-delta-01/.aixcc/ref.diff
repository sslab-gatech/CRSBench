+                    appendFileName(parts[i], format(attachmentNames[i], r));
+                    buffers[i].append(format(attachmentFormatters[i], r));
+                    if (locale != null && !locale.equals(lastLocale)) {
+                        appendContentLang(parts[i], locale);
+                    }
+                }
+            }
