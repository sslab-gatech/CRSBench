+    }
+
+    /*
+     * Only here to make accessible to POP3Message.
+     */
+    @Override
+    protected void notifyMessageChangedListeners(int type, Message m) {
+        super.notifyMessageChangedListeners(type, m);
+    }
+
+    /**
+     * Used by POP3Message.
+     */
+    TempFile getFileCache() {
+        return fileCache;
+    }
