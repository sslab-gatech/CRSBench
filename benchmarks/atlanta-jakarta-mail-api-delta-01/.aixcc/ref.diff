+    }
+
+    protected void idleWait() throws IOException {
+        String line = readLine();
+
+        if (line != null && !line.equalsIgnoreCase("DONE")) {
+            LOGGER.severe("Didn't get DONE response to IDLE");
+            exit();
+            return;
+        }
+    }
