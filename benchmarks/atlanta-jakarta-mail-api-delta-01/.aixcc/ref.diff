+/**
+ * An RFC822SIZE FETCH item.
+ *
+ * @author John Mani
+ */
+
+public class RFC822SIZE implements Item {
+
+    static final char[] name = {'R', 'F', 'C', '8', '2', '2', '.', 'S', 'I', 'Z', 'E'};
+    public int msgno;
+
+    public long size;
+
+    /**
+     * Constructor.
+     *
+     * @throws ParsingException for parsing failures
+     * @param    r    the FetchResponse
