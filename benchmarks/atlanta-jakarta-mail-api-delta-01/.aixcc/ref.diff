+            assertFalse(failed);
+            assertFalse(em.exceptions.isEmpty());
+        } finally {
+            logger.removeHandler(instance);
+            logger.setLevel((Level) null);
+            logger.setUseParentHandlers(true);
+            hardRef = null;
+        }
