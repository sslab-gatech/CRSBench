+        //names are different but equal encodings.
+        final String found = MimeUtility.mimeCharset(enc);
+        Class<?> k = Session.getInstance(new Properties())
+                .getTransport("smtp").getClass();
+        if (isPrivateSpec(k)) {
+            assertFalse(enc + "==" + found, enc.equals(found));
