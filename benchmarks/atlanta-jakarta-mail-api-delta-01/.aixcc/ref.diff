+
+        return new MimeMessage(s, new AsciiStringInputStream(content));
+    }
+
+    private static String getString(InputStream is) throws IOException {
+        BufferedReader r = new BufferedReader(new InputStreamReader(is));
+        return r.readLine();
+    }
