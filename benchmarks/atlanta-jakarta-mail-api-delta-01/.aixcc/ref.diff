+        test(new IMAPHandler() {
+            @Override
+            public void login() throws IOException {
+                untagged("CAPABILITY " + capabilities);
+                untagged("CAPABILITY " + NEWCAP);
+                ok("LOGIN completed");
+            }
+        });
+    }
+
+    /**
+     * Test untagged CAPABILITY response after AUTHENTICATE.
+     */
