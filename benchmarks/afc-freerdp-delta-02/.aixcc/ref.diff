 char* x509_utils_get_email(const X509* x509)
 {
 	char* result = 0;
@@ -845,6 +888,62 @@ static int verify_cb(int ok, X509_STORE_CTX* csc)
 	return ok;
 }
 
+BOOL verify_san(const char *subjectAltName) {
+    san_state_t state = STATE_START;
+    int len = strlen(subjectAltName);
+    int i;
+
+    for (i = 0; i < len; i++) {
+        char c = subjectAltName[i];
+
+        switch (state) {
+            case STATE_START:
+                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
+                    state = STATE_LABEL;
+                } else {
+                    return FALSE;
+                }
+                break;
+
+            case STATE_LABEL:
+                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+                    state = STATE_LABEL;
+                } else if (c == '-') {
+                    state = STATE_HYPHEN;
+                } else if (c == '.') {
+                    state = STATE_DOT;
+                } else {
+                    return FALSE;
+                }
+                break;
+
+            case STATE_HYPHEN:
+                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+                    state = STATE_LABEL;
+                } else {
+                    return FALSE;
+                }
+                break;
+
+            case STATE_DOT:
+                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
+                    state = STATE_LABEL;
+                } else {
+                    return FALSE;
+                }
+                break;
+
+            default:
+                return FALSE;
+        }
+    }
+
+	if ( state == STATE_LABEL)
+		return TRUE;
+	else
+		return FALSE;
+}
