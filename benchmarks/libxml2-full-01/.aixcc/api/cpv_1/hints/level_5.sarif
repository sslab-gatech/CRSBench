{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-416",
              "name": "CWE-416: Use After Free",
              "shortDescription": {
                "text": "Use After Free"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Use After Free"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-416",
          "level": "warning",
          "message": {
            "text": "CWE-416 - Use After Free\nVulnerability: Dangling pointer leading to Use After Free\nDescription: This vulnerability arises from the improper return of a comment node text pointer, which is then freed by a parent function. Use of this pointer later will result in a use after free."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tree.c"
                },
                "region": {
                  "startLine": 5623,
                  "endLine": 5625,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "free",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}