{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            },
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-193",
              "name": "CWE-193: Off-by-one Error",
              "shortDescription": {
                "text": "Off-by-one Error"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Off-by-one Error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow\nVulnerability: Off-by-one heap buffer overflow in buffer_write\nDescription: A heap-based buffer overflow vulnerability exists in the buffer_write function\nin utils.c due to an off-by-one error in the bounds check. The function uses\n'index > buf->size' instead of 'index >= buf->size', allowing writes at an\nindex equal to the buffer size, which is one byte past the valid range. For a\nbuffer of size N, valid indices are 0 to N-1, but this vulnerability allows\nwriting to index N. When triggered with input->c = 300 for a 300-byte buffer,\nthe code writes one byte past the allocated region, causing heap corruption.\nThis can lead to memory corruption, crashes, or potential arbitrary code\nexecution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 21,
                  "startColumn": 9,
                  "endColumn": 28
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write\nVulnerability: Off-by-one heap buffer overflow in buffer_write\nDescription: A heap-based buffer overflow vulnerability exists in the buffer_write function\nin utils.c due to an off-by-one error in the bounds check. The function uses\n'index > buf->size' instead of 'index >= buf->size', allowing writes at an\nindex equal to the buffer size, which is one byte past the valid range. For a\nbuffer of size N, valid indices are 0 to N-1, but this vulnerability allows\nwriting to index N. When triggered with input->c = 300 for a 300-byte buffer,\nthe code writes one byte past the allocated region, causing heap corruption.\nThis can lead to memory corruption, crashes, or potential arbitrary code\nexecution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 21,
                  "startColumn": 9,
                  "endColumn": 28
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-193",
          "level": "warning",
          "message": {
            "text": "CWE-193 - Off-by-one Error\nVulnerability: Off-by-one heap buffer overflow in buffer_write\nDescription: A heap-based buffer overflow vulnerability exists in the buffer_write function\nin utils.c due to an off-by-one error in the bounds check. The function uses\n'index > buf->size' instead of 'index >= buf->size', allowing writes at an\nindex equal to the buffer size, which is one byte past the valid range. For a\nbuffer of size N, valid indices are 0 to N-1, but this vulnerability allows\nwriting to index N. When triggered with input->c = 300 for a 300-byte buffer,\nthe code writes one byte past the allocated region, causing heap corruption.\nThis can lead to memory corruption, crashes, or potential arbitrary code\nexecution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 21,
                  "startColumn": 9,
                  "endColumn": 28
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}