{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            },
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-193",
              "name": "CWE-193: Off-by-one Error",
              "shortDescription": {
                "text": "Off-by-one Error"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Off-by-one Error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow in function(s): buffer_write"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write in function(s): buffer_write"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-193",
          "level": "warning",
          "message": {
            "text": "CWE-193 - Off-by-one Error in function(s): buffer_write"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utils.c"
                }
              },
              "logicalLocations": [
                {
                  "name": "buffer_write",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}