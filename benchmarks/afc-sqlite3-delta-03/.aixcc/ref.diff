+/*
+** Immediately view the internal representation of the database.
+** Useful for taking a look from within SQLite.
+*/
+void lsm1FunctionView(
+  sqlite3_context *ctx,
+  int argc,
+  sqlite3_value **argv
+){
+  lsm1_vtab* vtab = (lsm1_vtab*)sqlite3_user_data(ctx);
+  LsmString* ret = lsm1ViewInternal(vtab->pDb);
+  if( !ret ) {
+    sqlite3_result_error_nomem(ctx);
+  }else{
+    sqlite3_result_text(ctx, ret->z, -1, SQLITE_TRANSIENT);
+    lsmStringClear(ret);
+    lsm_free(vtab->pDb->pEnv, ret);
+  }
+}
+
+/*
+** This function allows the user to merge all sorted runs
+** and flush them out to disk right away. Useful for cleaning
+** for performance reasons.
+*/
+void lsm1FunctionFlush(
+  sqlite3_context *ctx,
+  int argc,
+  sqlite3_value **argv
+){
+  lsm1_vtab* vtab = (lsm1_vtab*)sqlite3_user_data(ctx);
+  lsm_db* pDb = vtab->pDb;
+  int rc = lsm1InternalFlush(pDb);
+  sqlite3_result_int(ctx, rc);
+}
 
