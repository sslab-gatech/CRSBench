+LsmString* lsm1ViewInternal(lsm_db* pDb){
+  LsmString* ret = 0;
+  int rc = lsmBeginWork(pDb);
+  if ( rc == LSM_OK ){
+    ret = lsmSortedDumpStructure(pDb, pDb->pWorker, LSM_LOG_DATA, 0, "view");
