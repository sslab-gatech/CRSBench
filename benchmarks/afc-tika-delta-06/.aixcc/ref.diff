+package org.apache.tika.parser.csv;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+public class CellFormatterTest {
+
+    @Test
+    public void testBasic() throws Exception {
+        CellFormatter cellFormatter = new CellFormatter();
+        String cell = null;
+        assertEquals("", cellFormatter.format(cell));
+
+        cell = "";
+        assertEquals("", cellFormatter.format(cell));
+
+        cell = "0.25 &fraction_format=\"# #/#\"";
+        assertEquals("1/4", cellFormatter.format(cell));
+
+        cell = "&fraction_format=\"# #/#\"";
+        assertEquals(cell.trim(), cellFormatter.format(cell));
+
+        cell = "1 &fraction_format=\"# #/#\"";
+        assertEquals("1", cellFormatter.format(cell));
+
+        cell = "42 &fraction_format=\"# #/#\"";
+        assertEquals("42", cellFormatter.format(cell));
+
+        cell = "      42 &fraction_format=\"# #/#\"                  ";
+        assertEquals("42", cellFormatter.format(cell));
+
+
+        cell = "42.0 &fraction_format=\"# #/#\"";
+        assertEquals("42", cellFormatter.format(cell));
+
+        cell = "42.00000000000001 &fraction_format=\"# #/#\"";
+        assertEquals("42", cellFormatter.format(cell));
+
+        cell = "4200000000000000000.1 &fraction_format=\"# #/#\"";
+        assertEquals("4200000000000000000", cellFormatter.format(cell));
+
+        cell = ".1 &fraction_format=\"# #/##\"";
+        assertEquals("1/10", cellFormatter.format(cell));
+
+        cell = "-.1 &fraction_format=\"# #/##\"";
+        assertEquals("-1/10", cellFormatter.format(cell));
+
+        cell = "+.1 &fraction_format=\"# #/##\"";
+        assertEquals("+1/10", cellFormatter.format(cell));
+
+        cell = "1.75 &fraction_format=\"# #/#\"";
+        assertEquals("1 3/4", cellFormatter.format(cell));
+
+        cell = "-1.75 &fraction_format=\"# #/#\"";
+        assertEquals("-1 3/4", cellFormatter.format(cell));
+
+        cell = "+1.75 &fraction_format=\"# #/#\"";
+        assertEquals("+1 3/4", cellFormatter.format(cell));
+
+        cell = "123456.6 &fraction_format=\"# #/#\"";
+        assertEquals("123456 3/5", cellFormatter.format(cell));
+
+        cell = "-123456.6 &fraction_format=\"# #/#\"";
+        assertEquals("-123456 3/5", cellFormatter.format(cell));
+
+    }
+
+    @Test
+    public void testPies() {
+        CellFormatter cellFormatter  = new CellFormatter();
+        String cell = "";
+        cell = "3.1415962 &fraction_format=\"# #/#\"";
+        assertEquals("3 1/7", cellFormatter.format(cell));
+
+        cell = "3.1415926535 &fraction_format=\"# #/###\"";
+        assertEquals("3 16/113", cellFormatter.format(cell));
+
+        cell = "3.14159265358979323846264338327950288419716939937510 &fraction_format=\"# #/#\"";
+        assertEquals(cell, cellFormatter.format(cell));
+
+        cell = "314159265358979323846264338327950288419716939937510 &fraction_format=\"# #/#\"";
+        assertEquals(cell, cellFormatter.format(cell));
+
+        cell = "3.1415926535897932384 &fraction_format=\"# ####/#####\"";
+        assertEquals("3 14093/99532", cellFormatter.format(cell));
+
+    }
+}
