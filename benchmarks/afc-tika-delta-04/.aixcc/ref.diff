+public class RecursivelyExtract {
+
+    private static Logger LOGGER = LoggerFactory.getLogger(RecursivelyExtract.class);
+
+    public static void main(String[] args) throws Exception {
+        Path workingDir = Files.createTempDirectory("tika-working-");
+
+        try {
+            Path inputDir = workingDir.resolve("input");
+            Path tikaConfig = workingDir.resolve("tika-config.xml");
+            Path outRoot = getOutputRoot(args);
+            String parserConfig = getParserConfig(args);
+            String inputFileName = args[args.length - 1];
+            String tmpInputFileName = FilenameUtils.getName(inputFileName);
+            //write temp tika-config.xml
+            Files.writeString(tikaConfig,
+                    getTikaConfigString(inputDir, outRoot, parserConfig),
+                    StandardCharsets.UTF_8);
+            if (! Files.isDirectory(inputDir)) {
+                Files.createDirectories(inputDir);
+            }
+            //copy input file over to input and rename it
+            Files.copy(Paths.get(inputFileName), inputDir.resolve(tmpInputFileName));
+
+            PipesServer pipesServer = new PipesServer(tikaConfig,
+                    new UnsynchronizedByteArrayInputStream(new byte[0]),
+                    new PrintStream(UnsynchronizedByteArrayOutputStream.builder().get(), true,
+                            StandardCharsets.UTF_8.name()),
+                    100000000, 30000, 30000);
+
+            pipesServer.initializeResources();
+            EmbeddedDocumentBytesConfig embeddedBytes = new EmbeddedDocumentBytesConfig();
+            embeddedBytes.setPathStrategy(EmbeddedDocumentBytesConfig.PATH_STRATEGY.EMBEDDED_PATH);
+            embeddedBytes.setEmitter("bytes");
+            embeddedBytes.setSuffixStrategy(EmbeddedDocumentBytesConfig.SUFFIX_STRATEGY.NONE);
+            ParseContext parseContext = new ParseContext();
+            parseContext.set(EmbeddedDocumentBytesConfig.class, embeddedBytes);
+            FetchEmitTuple fetchEmitTuple = new FetchEmitTuple("id",
+                    new FetchKey("fs", tmpInputFileName),
+                    new EmitKey("json", tmpInputFileName), new Metadata(), parseContext,
+                    DEFAULT_ON_PARSE_EXCEPTION);
+            if (! Files.isDirectory(outRoot)) {
+                Files.createDirectories(outRoot);
+            }
+            Fetcher fetcher = FetcherManager.load(tikaConfig).getFetcher();
+            PipesServer.MetadataListAndEmbeddedBytes
+                    parseData = pipesServer.parseFromTuple(fetchEmitTuple, fetcher);
+
+            try (Writer writer = Files.newBufferedWriter(outRoot.resolve(tmpInputFileName +
+                    ".json"))) {
+                JsonMetadataList.toJson(parseData.getMetadataList(), writer, true);
+            }
+
+        } finally {
+            FileUtils.deleteDirectory(workingDir.toFile());
+        }
+
+    }
+
+    private static String getTikaConfigString(Path inputDir, Path outRoot, String parserString)
+            throws IOException {
+        String template = IOUtils.toString(RecursivelyExtract.class.getResourceAsStream(
+                "/tika-recursively-extract-template.xml"), StandardCharsets.UTF_8);
+        template = template.replace("FETCH_BASE_PATH", inputDir.toAbsolutePath().toString());
+        template = template.replace("EMIT_JSON_BASE_PATH",
+                outRoot.resolve("json").toAbsolutePath().toString());
+        template = template.replace("EMIT_BYTES_BASE_PATH",
+                outRoot.resolve(".").toAbsolutePath().toString());
+        template = template.replace("PARSERS", parserString);
+
+        return template;
+    }
+
+
+    private static Path getOutputRoot(String[] args) {
+        for (String s : args) {
+            if (s.startsWith("--extract-dir=")) {
+                return Paths.get(s.substring("--extract-dir=".length()));
+            }
+        }
+        return Paths.get("output");
+    }
+
+    private static String getParserConfig(String[] args) throws IOException {
+        for (String s : args) {
+            if (s.startsWith("--config=")) {
+                Path tikaConfigPath = Paths.get(s.substring("--config=".length()));
+                String xml = Files.readString(tikaConfigPath, StandardCharsets.UTF_8);
+                Matcher m = Pattern.compile("(?s)(<parsers>.*?</parsers>)").matcher(xml);
+                if (m.find()) {
+                    return m.group(1);
+                }
+            }
+        }
+        return "";
+    }
+}
