{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-400",
              "name": "CWE-400: Uncontrolled Resource Consumption",
              "shortDescription": {
                "text": "Uncontrolled Resource Consumption"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Uncontrolled Resource Consumption"
              }
            },
            {
              "id": "CWE-770",
              "name": "CWE-770: Allocation of Resources Without Limits or Throttling",
              "shortDescription": {
                "text": "Allocation of Resources Without Limits or Throttling"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Allocation of Resources Without Limits or Throttling"
              }
            },
            {
              "id": "CWE-20",
              "name": "CWE-20: Improper Input Validation",
              "shortDescription": {
                "text": "Improper Input Validation"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Improper Input Validation"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-400",
          "level": "warning",
          "message": {
            "text": "CWE-400 - Uncontrolled Resource Consumption"
          }
        },
        {
          "ruleId": "CWE-770",
          "level": "warning",
          "message": {
            "text": "CWE-770 - Allocation of Resources Without Limits or Throttling"
          }
        },
        {
          "ruleId": "CWE-20",
          "level": "warning",
          "message": {
            "text": "CWE-20 - Improper Input Validation"
          }
        }
      ]
    }
  ]
}