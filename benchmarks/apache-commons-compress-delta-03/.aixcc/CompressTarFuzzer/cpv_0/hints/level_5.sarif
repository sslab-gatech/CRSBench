        {
          "ruleId": "CWE-400",
          "level": "warning",
          "message": {
            "text": "CWE-400 - Uncontrolled Resource Consumption\nVulnerability: BigDecimal DoS in a tar file\nDescription: This reintroduces a variant of CVE-2023-42503. Java's BigDecimal is vulnerable to a DoS on very high precision numbers. This  modifies the regex that was put in place to defend against CVE-2023-42503 so that the BigDecimal DoS attack is available."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/org/apache/commons/compress/archivers/tar/TarArchiveEntry.java"
                },
                "region": {
                  "startLine": 221,
                  "endLine": 222,
                  "startColumn": 5,
                  "endColumn": 56
                }
              },
              "logicalLocations": [
                {
                  "name": "waitForReferencePendingList",
                  "kind": "function"
                }
              ]
            }
          ]
        },
