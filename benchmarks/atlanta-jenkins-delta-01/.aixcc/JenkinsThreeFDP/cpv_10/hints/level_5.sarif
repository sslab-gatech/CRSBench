          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "plugins/toy-plugin/src/main/java/io/jenkins/plugins/toyplugin/SecretMessage.java"
                },
                "region": {
                  "startLine": 98,
                  "endLine": 98,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "loadLibraryHook",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
