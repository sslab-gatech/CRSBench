                "text": "Inclusion of Functionality from Untrusted Control Sphere"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Inclusion of Functionality from Untrusted Control Sphere"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-829",
          "level": "warning",
          "message": {
            "text": "CWE-829 - Inclusion of Functionality from Untrusted Control Sphere\nVulnerability: FuzzerSecurityIssueHigh: load arbitrary library (TBD)\nDescription: FuzzerSecurityIssueHigh: load arbitrary library (TBD)"
