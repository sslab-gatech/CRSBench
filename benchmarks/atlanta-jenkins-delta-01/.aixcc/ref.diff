+import jenkins.model.Jenkins;
+
+public class AccessFilterTest {
+
+    static AccessFilter action;
+    static StaplerReplacer replacer;
+    static ResponseImpl response;
+    static StringWriter writer;
+    static int response_code;
+
+    @BeforeAll
+    static void setUp() throws Exception {
+        action = new AccessFilter();
+
+        replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+
+        HttpServletResponse inner_response = Mockito.mock(HttpServletResponse.class);
+        writer = new StringWriter();
+        PrintWriter printWriter = new PrintWriter(writer);
+        when(inner_response.getWriter()).thenReturn(printWriter);
+        when(inner_response.getWriter()).thenReturn(printWriter);
+        doAnswer(new Answer<Void>() {
+            public Void answer(InvocationOnMock invocation) throws Throwable {
+                response_code = invocation.getArgument(0);
+                return null;
+            }
+        }).when(inner_response).sendError(anyInt());
+        response = new ResponseImpl(replacer.stapler, inner_response);
+        replacer.setCurrentResponse(response);  
+        response_code = 200;  
+    }
+
+    @AfterEach
+    public void clean() {
+        writer.getBuffer().setLength(0);
+        response_code = 200;
+    }
+
+    @Test
+    public void test_get() throws Exception {
+        RequestImpl request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doGet(request, response);
+        List<String> data = new Gson().fromJson(writer.toString(), new TypeToken<List<String>>(){}.getType());
+        assertEquals(data.size(), 1);
+        for (String access : data) {
+            String[] parts = access.split(" ");
+            assertEquals(parts.length, 2);
+            assertEquals(parts[1], "192.0.0.1");
+        }
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doGet(request, response);
+        data = new Gson().fromJson(writer.toString(), new TypeToken<List<String>>(){}.getType());
+        assertEquals(data.size(), 2);
+        for (String access : data) {
+            String[] parts = access.split(" ");
+            assertEquals(parts.length, 2);
+            assertEquals(parts[1], "192.0.0.1");
+        }
+    }
+
+    @Test
+    public void test_get_invalid_parameter() throws Exception {
+        RequestImpl request = prepare(Map.of("invalid", "192.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_BAD_REQUEST);
+    }
+
+    @Test
+    public void test_get_invalid_format() throws Exception {
+        RequestImpl request = prepare(Map.of("ip", ".*"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_BAD_REQUEST);
+    }
+
+    @Test
+    public void test_get_allowed_invalid_format() throws Exception {
+        RequestImpl request = prepare(Collections.emptyMap(), Jenkins.ADMINISTER);
+        action.doClean(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "127.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", ".*", "skip", "True"), Jenkins.ADMINISTER);
+        action.doGet(request, response);
+        List<String> data = new Gson().fromJson(writer.toString(), new TypeToken<List<String>>(){}.getType());
+        assertEquals(data.size(), 2);
+    }
+
+    @Test
+    public void test_clean() throws Exception {
+        RequestImpl request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doAdd(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doGet(request, response);
+        List<String> data = new Gson().fromJson(writer.toString(), new TypeToken<List<String>>(){}.getType());
+        assertNotEquals(data.size(), 0);
+
+        request = prepare(Collections.emptyMap(), Jenkins.ADMINISTER);
+        action.doClean(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_OK);
+
+        request = prepare(Map.of("ip", "192.0.0.1"), null);
+        action.doGet(request, response);
+        data = new Gson().fromJson(writer.toString(), new TypeToken<List<String>>(){}.getType());
+        assertEquals(data.size(), 0);
+    }
+
+    @Test
+    public void test_clean_unauthorized() throws Exception {
+        RequestImpl request = prepare(Collections.emptyMap(), null);
+        action.doClean(request, response);
+        assertEquals(response_code, HttpServletResponse.SC_UNAUTHORIZED);
+    }
+
+    RequestImpl prepare(Map<String, String> parameters, Permission permission) {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        if (permission != null) {
+            when(j.hasPermission(permission)).thenReturn(true);
+        }
+        action.setJenkins(j);
+
+        HttpServletRequest inner_request = Mockito.mock(HttpServletRequest.class);        
+        for (Entry<String, String> entry : parameters.entrySet()) {
+            when(inner_request.getParameter(entry.getKey())).thenReturn(entry.getValue());
+        }
+        writer.getBuffer().setLength(0);
+        response_code = 200;
+        RequestImpl request = new RequestImpl(replacer.stapler, inner_request, Collections.emptyList(), null);
+        replacer.setCurrentRequest(request);
+        return request;
+    }
+}
