+        assertEquals("UNIMPLEMENTED!", emailConfig.okForPublish());
+        assertTrue(emailConfig.publishReady);
+    }
+
+    @Test
+    void testSetEmailAddress() {
+        String optInput = "test@example.com";
+        emailConfig.optCache = optInput;
+        assertEquals(1, emailConfig.setEmailAddress());
+        assertEquals(optInput, emailConfig.emailAddress);
+    }
+
+    @Test
+    void testConstructor_EmailMethod() {
+        emailConfig.emailAddress = "getEmail";
+        assertEquals("No email address set yet", emailConfig.constructor());
+    }
+
+    @Test
+    void testConstructor_InvalidMethod() {
+        emailConfig.emailAddress = "invalidMethod";
+        assertEquals("ERROR", emailConfig.constructor());
+    }
+
+    @Test
+    void testWrapUp_PublishReady() {
+        emailConfig.publishReady = true;
+        emailConfig.emailAddress = "user@example.com";
+        assertEquals("Thank you for subscribing to emails,user@example.com! We will alert you if anything comes up", 
+                     emailConfig.wrapUp());
+    }
+
+    @Test
+    void testWrapUp_NotPublishReady() {
+        assertEquals("ERROR", emailConfig.wrapUp());
+    }
+
+    @Test
+    void testDestructor() {
+        assertEquals("OK", emailConfig.destructor());
+    }
+
+    @Test
+    void testOperateState_ValidStates() {
+        emailConfig.optCache = "test@example.com";
+        assertEquals("No email address set yet", emailConfig.operateState(0, ""));
+        assertEquals("1", emailConfig.operateState(1, "test@example.com"));
+        assertEquals("OK", emailConfig.operateState(2, ""));
+        assertEquals("UNIMPLEMENTED!", emailConfig.operateState(3, ""));
+        assertEquals("Thank you for subscribing to emails,test@example.com! We will alert you if anything comes up", emailConfig.operateState(4, ""));
+        assertEquals("OK", emailConfig.operateState(5, ""));
+    }
+
+    @Test
+    void testOperateState_InvalidState() {
+        assertEquals("Bad state, please report this error to the developers6", emailConfig.operateState(6, ""));
+    }
+
+    @Test
+    public void testDebug() throws Exception {
+        EmailConfig emConfig = new EmailConfig();
+
+        Method debugEnableMethod = EmailConfig.class.getDeclaredMethod("debugEnable");
+
+        debugEnableMethod.setAccessible(true);
+        debugEnableMethod.invoke(emConfig);
+
+        Method debugFunctionMethod = EmailConfig.class.getDeclaredMethod("debugOnlyAndPrivate");
