@@ -0,0 +1,101 @@
+package hudson;
+
+import hudson.ProxyConfiguration;
+import hudson.util.FormValidation;
+import hudson.util.Secret;
+import jenkins.model.Jenkins;
+import org.junit.jupiter.api.Test;
+import org.kohsuke.stapler.*;
+import org.mockito.Mockito;
+import org.springframework.security.access.AccessDeniedException;
+
+import javax.servlet.ServletContext;
+import javax.servlet.http.HttpServletRequest;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import aixcc.util.StaplerReplacer;
+
+public class ProxyConfigurationTest {
+    @Test
+    public void test_testurl_empty() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy(null, req, rsp).toString()
+                .equals("ERROR: Test URL is required."));
+    }
+
+    @Test
+    public void test_invalid_testurl() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy("http://[invalid]", req, rsp).toString()
+                .startsWith("ERROR: Malformed Test URL"));
+    }
+
+    @Test
+    public void test_name_empty() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy("http://httpbin.org", req, rsp).toString()
+                .equals("ERROR: Missing parameter [name]"));
+    }
+
+    @Test
+    public void test_port_empty() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        when(innerReq.getParameter("name")).thenReturn("proxyHost");
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy("http://httpbin.org", req, rsp).toString()
+                .equals("ERROR: Missing parameter [port]"));
+    }
+
+    @Test
+    public void test_port_invalid() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        when(innerReq.getParameter("name")).thenReturn("proxyHost");
+        when(innerReq.getParameter("port")).thenReturn("invalid");
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy("http://httpbin.org", req, rsp).toString()
+                .equals("ERROR: Invalid value for parameter [port]"));
+    }
+
+    @Test
+    public void test_noproxy() throws Exception {
+        Jenkins j = Mockito.mock(Jenkins.class);
+        StaplerReplacer replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        HttpServletRequest innerReq = Mockito.mock(HttpServletRequest.class);
+        when(innerReq.getParameter("name")).thenReturn("proxyHost");
+        when(innerReq.getParameter("port")).thenReturn("8080");
+        when(innerReq.getParameter("noproxyhost")).thenReturn("proxyHost");
+        RequestImpl req = new RequestImpl(replacer.stapler, innerReq, Collections.emptyList(), null);
+        ResponseImpl rsp = Mockito.mock(ResponseImpl.class);
+        assertTrue(new ProxyConfiguration.DescriptorImpl2(j).doValidateProxy("http://localhost:8888", req, rsp)
+                .toString().startsWith("ERROR: Failed to connect"));
+    }
+}
