+    @Test
+    public void testLoad() throws Exception {
+        LocalFileKnowledgeBase kb = new LocalFileKnowledgeBase();
+        LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor descriptor = new LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor();
+        prepareLoadTest(causePath);
+        assertNull(kb.getCause("0"));
+        assertNull(kb.getCause("1"));
+        kb.load();
+        assertNotNull(kb.getCause("0"));
+        assertNotNull(kb.getCause("1"));
+        FileUtils.deleteDirectory(causePath.toFile());
+        kb.removeCause("0");
+        kb.removeCause("1");
+
+        prepareLoadTest(causePath);
+        assertNull(kb.getCause("0"));
+        assertNull(kb.getCause("1"));
+        when(jenkins.hasPermission(PluginImpl.REMOVE_PERMISSION)).thenReturn(true);
+        when(jenkins.hasPermission(PluginImpl.UPDATE_PERMISSION)).thenReturn(true);
+        when(plugin.getKnowledgeBase()).thenReturn(kb);
+        StaplerRequest request = mock(StaplerRequest.class);
+        descriptor.doLoad(request);
+        assertNotNull(kb.getCause("0"));
+        assertNotNull(kb.getCause("1"));
+        FileUtils.deleteDirectory(causePath.toFile());
+        when(jenkins.hasPermission(PluginImpl.REMOVE_PERMISSION)).thenReturn(false);
+        when(jenkins.hasPermission(PluginImpl.UPDATE_PERMISSION)).thenReturn(false);
+        when(plugin.getKnowledgeBase()).thenReturn(null);
+    }
+
+    private void prepareLoadTest(Path path) throws Exception {
+        if (!Files.exists(path)) {
+            Files.createDirectories(path);
+        }
+        Map<String, FailureCause> causes = Map.of("0", new FailureCause("0", ""), "1", new FailureCause("1", ""));
+        for (Map.Entry<String, FailureCause> entry : causes.entrySet()) {
+            FailureCause value = entry.getValue();
+            value.setId(value.getName());
+            Path filePath = path.resolve(value.getId());
+            try (FileOutputStream fos = new FileOutputStream(filePath.toFile());
+                    ObjectOutputStream oos = new ObjectOutputStream(fos)) {
+                oos.writeObject(entry.getValue());
+            }
+        }
+    }
+
+    @Test
+    public void testSave() throws Exception {
+        LocalFileKnowledgeBase kb = new LocalFileKnowledgeBase();
+        LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor descriptor = new LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor();
+        FailureCause cause1 = new FailureCause("0", "");
+        FailureCause cause2 = new FailureCause("1", "");
+        cause1.setId(cause1.getName());
+        cause2.setId(cause2.getName());
+        kb.put(cause1);
+        kb.put(cause2);
+        assertFalse(Files.exists(causePath.resolve("0")));
+        assertFalse(Files.exists(causePath.resolve("1")));
+        kb.save();
+        assertTrue(Files.exists(causePath.resolve("0")));
+        assertTrue(Files.exists(causePath.resolve("1")));
+        FileUtils.deleteDirectory(causePath.toFile());
+
+        when(jenkins.hasPermission(PluginImpl.UPDATE_PERMISSION)).thenReturn(true);
+        when(plugin.getKnowledgeBase()).thenReturn(kb);
+        StaplerRequest request = mock(StaplerRequest.class);
+        assertFalse(Files.exists(causePath.resolve("0")));
+        assertFalse(Files.exists(causePath.resolve("1")));
+        descriptor.doSave(request);
+        assertTrue(Files.exists(causePath.resolve("0")));
+        assertTrue(Files.exists(causePath.resolve("1")));
+        FileUtils.deleteDirectory(causePath.toFile());
+        when(jenkins.hasPermission(PluginImpl.UPDATE_PERMISSION)).thenReturn(false);
+    }
+
+    @Test
+    public void testForceUpdate() throws Exception {
+        LocalFileKnowledgeBase kb = new LocalFileKnowledgeBase();
+        LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor descriptor = new LocalFileKnowledgeBase.LocalFileKnowledgeBaseDescriptor();
+        FailureCause cause1 = new FailureCause("0", "A");
+        cause1.setId(cause1.getName());
+        FailureCause cause2 = new FailureCause("0", "B");
+        cause2.setId(cause2.getName());
+        byte data[] = prepareForceUpdateTest(cause2);
+
+        assertNull(kb.getCause("0"));
+        assertFalse(kb.updateForcefully(cause2.getId(), data));
+        assertThrows(IOException.class, () -> {
+            kb.load();
+        });
+        assertNull(kb.getCause("0"));
+
+        kb.put(cause1);
+        kb.save();
+        kb.load();
+        assertTrue(kb.getCause("0").getDescription().equals("A"));
+        kb.updateForcefully("0", data);
+        kb.load();
+        assertTrue(kb.getCause("0").getDescription().equals("B"));
+
+        kb.removeCause("0");
+        FileUtils.deleteDirectory(causePath.toFile());
+
+        StaplerRequest request = mock(StaplerRequest.class);
+        when(request.hasParameter("id")).thenReturn(true);
+        when(request.hasParameter("data")).thenReturn(true);
+        when(request.getParameter("id")).thenReturn(cause2.getId());
+        when(request.getParameter("data")).thenReturn(new String(Base64.getEncoder().encode(data)));
+        when(jenkins.hasPermission(Jenkins.ADMINISTER)).thenReturn(true);
+        when(plugin.getKnowledgeBase()).thenReturn(kb);
+
+        assertNull(kb.getCause("0"));
+        descriptor.doForceUpdate(request);
+        assertThrows(IOException.class, () -> {
+            kb.load();
+        });
+        assertNull(kb.getCause("0"));
+
+        kb.put(cause1);
+        kb.save();
+        kb.load();
+        assertTrue(kb.getCause("0").getDescription().equals("A"));
+        descriptor.doForceUpdate(request);
+        kb.load();
+        assertTrue(kb.getCause("0").getDescription().equals("B"));
+
+        when(jenkins.hasPermission(Jenkins.ADMINISTER)).thenReturn(false);
+        when(plugin.getKnowledgeBase()).thenReturn(null);
+        FileUtils.deleteDirectory(causePath.toFile());
+    }
+
+    private byte[] prepareForceUpdateTest(FailureCause cause) throws Exception {
+        cause.setId(cause.getName());
+        try (ByteArrayOutputStream baos = new ByteArrayOutputStream();
+                ObjectOutputStream oos = new ObjectOutputStream(baos)) {
+            oos.writeObject(cause);
+            return baos.toByteArray();
+        }
+    }
+}
