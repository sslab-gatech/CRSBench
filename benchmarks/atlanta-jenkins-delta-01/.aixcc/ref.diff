+/**
+ * Hudson tests for {@link CauseManagement}.
+ *
+ * @author Robert Sandell &lt;robert.sandell@sonyericsson.com&gt;
+ */
+public class CauseManagementHudsonTest {
+
+    MockWebServer webServer;
+    Jenkins jenkins = Mockito.mock(Jenkins.class);
+    CauseManagement causeManagement = new CauseManagement();
+
+    @Before
+    public void setUp() throws Exception {
+        webServer = new MockWebServer();
+        webServer.enqueue(new MockResponse()
+                .setResponseCode(200)
+                .setBody("Mock response body"));
+
+        Jenkins.set(new Jenkins.JenkinsHolder() {
+            @Override
+            public Jenkins getInstance() {
+                return jenkins;
+            }
+        });
+    }
+
+    @After
+    public void tearDown() throws Exception {
+        webServer.shutdown();
+    }
+
+    @BeforeEach
+    public void beforeEach() throws Exception {
+        when(jenkins.hasPermission(PluginImpl.REMOVE_PERMISSION)).thenReturn(false);
+    }
+
+    @Test
+    public void testDoRemoveConfirm() throws Exception {
+        when(jenkins.hasPermission(PluginImpl.REMOVE_PERMISSION)).thenReturn(true);
+        PluginImpl plugin = Mockito.mock(PluginImpl.class);
+        PluginImpl.setInstance(plugin);
+        LocalFileKnowledgeBase knowledgeBase = spy(new LocalFileKnowledgeBase());
+        when(plugin.getKnowledgeBase()).thenReturn(knowledgeBase);
+        LocalFileKnowledgeBase.setPlugin(plugin);
+
+        FailureCause cause = new FailureCause("SomeName", "A Description");
+        cause.addIndication(new BuildLogIndication("."));
+        FailureCause cause1 = plugin.getKnowledgeBase().addCause(cause);
+        cause = new FailureCause("SomeOtherName", "A Description");
+        cause.addIndication(new BuildLogIndication("."));
+        FailureCause cause2 = plugin.getKnowledgeBase().addCause(cause);
+        String url = webServer.url("/test").toString();
+        cause = new FailureCause("ForNotice", "A Description", "notice:" + url);
+        FailureCause cause3 = plugin.getKnowledgeBase().addCause(cause);
+
+        // KnowledgeBase kb = spy(plugin.getKnowledgeBase());
+        Whitebox.setInternalState(plugin, KnowledgeBase.class, knowledgeBase);
+
+        StaplerRequest request = mock(StaplerRequest.class);
+        HttpSession session = mock(HttpSession.class);
+        when(request.getSession(anyBoolean())).thenReturn(session);
+        StaplerResponse response = mock(StaplerResponse.class);
+
+        causeManagement.doRemoveConfirm(cause1.getId(), request, response);
+
+        verify(knowledgeBase).removeCause(eq(cause1.getId()));
+        verify(session).setAttribute(eq(CauseManagement.SESSION_REMOVED_FAILURE_CAUSE), same(cause1));
+
+        // Check that it is gone.
+        assertNull(knowledgeBase.getCause(cause1.getId()));
+        assertNull(webServer.takeRequest(500, TimeUnit.MILLISECONDS));
+
+        // Check that the other one is still there
+        assertSame(cause2, knowledgeBase.getCause(cause2.getId()));
+        assertSame(cause3, knowledgeBase.getCause(cause3.getId()));
+
+        causeManagement.doRemoveConfirm(cause3.getId(), request, response);
+        RecordedRequest recordedRequest = webServer.takeRequest();
+        assertEquals("/test", recordedRequest.getPath());
+        assertEquals("GET", recordedRequest.getMethod());
+
+        assertSame(cause2, knowledgeBase.getCause(cause2.getId()));
+        assertNull(knowledgeBase.getCause(cause3.getId()));
+    }
+}
