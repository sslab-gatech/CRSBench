@@ -0,0 +1,62 @@
+package hudson.plugins.emailext;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Assertions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class EmailStateRunTest {
+
+    @Test
+    void testSequentialJumpVal() {
+        EmailStateRun emailStateRun = new EmailStateRun();
+        List<EmailStageList> stageLists = new ArrayList<>();
+
+        stageLists.add(makeStageList("email@test.com", "0")); 
+        stageLists.add(makeStageList("data2", "0"));
+        stageLists.add(makeStageList("data3", "0"));
+        stageLists.add(makeStageList("", "0"));
+        stageLists.add(makeStageList("", "0"));
+        stageLists.add(makeStageList("", "0"));
+
+
+        String output = emailStateRun.run(stageLists);
+
+        Assertions.assertFalse(output.contains("Bad value entered!"), "fail");
+        Assertions.assertFalse(output.contains("ERROR"), "fail");
+
+    }
+
+    @Test
+    void testBackwardJumpVal() {
+        EmailStateRun emailStateRun = new EmailStateRun();
+        List<EmailStageList> stageLists = new ArrayList<>();
+
+        stageLists.add(makeStageList("email@test.com", "0"));   
+        stageLists.add(makeStageList("someInput", "-1"));       
+
+        String output = emailStateRun.run(stageLists);
+
+        Assertions.assertFalse(output.contains("Bad value entered!"), "fail");
+        Assertions.assertFalse(output.contains("ERROR"), "fail");
+
+    }
+
+    @Test
+    void testOutOfRangeJumpVal() {
+        EmailStateRun emailStateRun = new EmailStateRun();
+        List<EmailStageList> stageLists = new ArrayList<>();
+        stageLists.add(makeStageList("", "10"));
+
+        String output = emailStateRun.run(stageLists);
+
+        Assertions.assertTrue(output.contains("Bad value entered!"), "fail");
+    }
+
+    private EmailStageList makeStageList(String data, String jumpVal) {
+        EmailStageList stage = new EmailStageList();
+        stage.data = data;
+        stage.stageJump = jumpVal;
+        return stage;
+    }
+}
