+import javax.servlet.ServletContext;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import aixcc.util.StaplerReplacer;
+
+public class StateMonitorTest {
+
+    static StaplerReplacer replacer;
+    static RequestImpl req;
+    static ResponseImpl rsp;
+    static StringWriter strWriter;
+    static StateMonitor action;
+    static int response_code;
+
+    @Test
+    void testCheck() throws Exception {
+        assertEquals(getState(), "{\"status\": \"STABLE\"}");
+    }
+
+    @Test
+    void testUpdate() throws Exception {
+        updateState("UNSTABLE");
+        assertEquals(getState(), "{\"status\": \"UNSTABLE\"}");
+        updateState("STABLE");
+        assertEquals(getState(), "{\"status\": \"STABLE\"}");
+    }
+
+    @Test
+    void testBadRequest() throws Exception {
+        prepare("!!!", "@@@");
+        action.doCheck(req, rsp);
+        assertNotEquals(response_code, 200);
+    }
+
+    @Test
+    void testUnauthorized() throws Exception {
+        prepare("admin", "admin");
+        action.doCheck(req, rsp);
+        assertNotEquals(response_code, 200);
+    }
+
+    @BeforeAll
+    public static void setUp() throws Exception {
+        strWriter = new StringWriter();
+        replacer = new StaplerReplacer();
+        replacer.setWebApp(new WebApp(Mockito.mock(ServletContext.class)));
+        action = new StateMonitor();
+    }
+
+    @AfterAll
+    public static void tearDown() {
+        strWriter = null;
+        req = null;
+        rsp = null;
+        replacer = null;
+        action = null;
+    }
+
+    private static String getState() throws Exception {
+        prepare("admin", "nimda");
+        action.doCheck(req, rsp);
+        return strWriter.toString();
+    }
+
+    private static void updateState(String state) throws Exception {
+        prepare("admin", "nimda");
+        action.doUpdate(state, req, rsp);
+    }
+
+    private static void prepare(String name, String password) throws Exception {
+        HttpServletRequest inner_req = Mockito.mock(HttpServletRequest.class);
+        req = new RequestImpl(replacer.stapler, inner_req, Collections.emptyList(), null);
+        HttpServletResponse inner_rsp = Mockito.mock(HttpServletResponse.class);
+        rsp = new ResponseImpl(replacer.stapler, inner_rsp);
+        PrintWriter pw = new PrintWriter(strWriter);
+        replacer.setCurrentRequest(req);
+        replacer.setCurrentResponse(rsp);
+        when(inner_req.getParameter("name")).thenReturn(name);
+        when(inner_req.getParameter("password")).thenReturn(password);
+        when(inner_rsp.getWriter()).thenReturn(pw);
+        doAnswer(new Answer<Void>() {
+            public Void answer(InvocationOnMock invocation) throws Throwable {
+                response_code = invocation.getArgument(0);
+                return null;
+            }
+        }).when(inner_rsp).sendError(anyInt());
+        strWriter.getBuffer().setLength(0);
+    }
+}
