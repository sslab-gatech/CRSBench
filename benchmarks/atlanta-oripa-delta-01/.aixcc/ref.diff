+package oripa.persistence.doc.loader;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.beans.XMLEncoder;
+import java.io.BufferedOutputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import oripa.DataSet;
+import oripa.OriLineProxy;
+import oripa.persistence.filetool.FileVersionError;
+import oripa.persistence.filetool.WrongDataFormatException;
+import oripa.resource.Version;
+import oripa.value.OriLine;
+import oripa.vecmath.Vector2d;
+
+class LoaderXMLTest {
+
+	@TempDir
+	Path tempDir;
+
+	private LoaderXML loader;
+	private Path validXmlFile;
+
+	@BeforeEach
+	void setUp() throws Exception {
+		loader = new LoaderXML();
+	}
+
+	@AfterEach
+	void tearDown() {
+		// Cleanup handled by @TempDir
+	}
+
+	private DataSet createValidDataSet() {
+		DataSet dataSet = new DataSet();
+		dataSet.setMainVersion(Version.FILE_MAJOR_VERSION);
+		dataSet.setSubVersion(Version.FILE_MINOR_VERSION);
+		dataSet.setPaperSize(400.0);
+		dataSet.setTitle("Test Title");
+		dataSet.setEditorName("Test Editor");
+		dataSet.setOriginalAuthorName("Test Author");
+		dataSet.setReference("Test Reference");
+		dataSet.setMemo("Test Memo");
+
+		// Create sample lines (a simple square)
+		OriLineProxy[] lines = new OriLineProxy[4];
+		lines[0] = createOriLineProxy(0.0, 0.0, 100.0, 0.0, OriLine.Type.CUT);
+		lines[1] = createOriLineProxy(100.0, 0.0, 100.0, 100.0, OriLine.Type.CUT);
+		lines[2] = createOriLineProxy(100.0, 100.0, 0.0, 100.0, OriLine.Type.CUT);
+		lines[3] = createOriLineProxy(0.0, 100.0, 0.0, 0.0, OriLine.Type.CUT);
+		dataSet.setLines(lines);
+
+		return dataSet;
+	}
+
+	private OriLineProxy createOriLineProxy(double x0, double y0, double x1, double y1, OriLine.Type type) {
+		OriLine line = new OriLine(new Vector2d(x0, y0), new Vector2d(x1, y1), type);
+		return new OriLineProxy(line);
+	}
+
+	private Path writeDataSetToXml(DataSet dataSet, String fileName) throws IOException {
+		Path xmlPath = tempDir.resolve(fileName);
+		try (var fos = new FileOutputStream(xmlPath.toFile());
+				var bos = new BufferedOutputStream(fos);
+				var enc = new XMLEncoder(bos)) {
+			enc.writeObject(dataSet);
+		}
+		return xmlPath;
+	}
+
+	@Test
+	void testLoad_validFile() throws Exception {
+		// Arrange
+		DataSet originalDataSet = createValidDataSet();
+		validXmlFile = writeDataSetToXml(originalDataSet, "valid_load.opx");
+
+		// Act
+		var docOptional = loader.load(validXmlFile.toString());
+
+		// Assert
+		assertTrue(docOptional.isPresent());
+		var doc = docOptional.get();
+		assertNotNull(doc);
+		assertNotNull(doc.getCreasePattern());
+		assertEquals(originalDataSet.getTitle(), doc.getProperty().getTitle());
+	}
+
+	@Test
+	void testLoad_fileVersionError() throws Exception {
+		// Arrange
+		DataSet futureVersionDataSet = createValidDataSet();
+		futureVersionDataSet.setMainVersion(Version.FILE_MAJOR_VERSION + 1);
+		validXmlFile = writeDataSetToXml(futureVersionDataSet, "future_version.opx");
+
+		// Act & Assert
+		assertThrows(FileVersionError.class, () -> loader.load(validXmlFile.toString()));
+	}
+
+	@Test
+	void testLoad_emptyLines() throws Exception {
+		// Arrange
+		DataSet dataSet = new DataSet();
+		dataSet.setMainVersion(Version.FILE_MAJOR_VERSION);
+		dataSet.setSubVersion(Version.FILE_MINOR_VERSION);
+		dataSet.setPaperSize(400.0);
+		dataSet.setTitle("Empty Lines Test");
+		dataSet.setLines(new OriLineProxy[0]);
+		validXmlFile = writeDataSetToXml(dataSet, "empty_lines.opx");
+
+		// Act
+		var docOptional = loader.load(validXmlFile.toString());
+
+		// Assert
+		assertTrue(docOptional.isPresent());
+		assertNotNull(docOptional.get().getCreasePattern());
+	}
+
+	@Test
+	void testLoad_withMountainAndValleyLines() throws Exception {
+		// Arrange
+		DataSet dataSet = createValidDataSet();
+		OriLineProxy[] lines = new OriLineProxy[6];
+		lines[0] = createOriLineProxy(0.0, 0.0, 100.0, 0.0, OriLine.Type.CUT);
+		lines[1] = createOriLineProxy(100.0, 0.0, 100.0, 100.0, OriLine.Type.CUT);
+		lines[2] = createOriLineProxy(100.0, 100.0, 0.0, 100.0, OriLine.Type.CUT);
+		lines[3] = createOriLineProxy(0.0, 100.0, 0.0, 0.0, OriLine.Type.CUT);
+		lines[4] = createOriLineProxy(0.0, 0.0, 100.0, 100.0, OriLine.Type.MOUNTAIN);
+		lines[5] = createOriLineProxy(100.0, 0.0, 0.0, 100.0, OriLine.Type.VALLEY);
+		dataSet.setLines(lines);
+		validXmlFile = writeDataSetToXml(dataSet, "mountain_valley.opx");
+
+		// Act
+		var docOptional = loader.load(validXmlFile.toString());
+
+		// Assert
+		assertTrue(docOptional.isPresent());
+		var cp = docOptional.get().getCreasePattern();
+		assertNotNull(cp);
+	}
+
+	@Test
+	void testLoad_currentVersionFile() throws Exception {
+		// Arrange - ensure current version files load correctly
+		DataSet dataSet = createValidDataSet();
+		dataSet.setMainVersion(Version.FILE_MAJOR_VERSION);
+		validXmlFile = writeDataSetToXml(dataSet, "current_version.opx");
+
+		// Act
+		var docOptional = loader.load(validXmlFile.toString());
+
+		// Assert
+		assertTrue(docOptional.isPresent());
+	}
+
+	@Test
+	void testLoad_olderVersionFile() throws Exception {
+		// Arrange - older version should load without error
+		DataSet dataSet = createValidDataSet();
+		dataSet.setMainVersion(Version.FILE_MAJOR_VERSION - 1);
+		validXmlFile = writeDataSetToXml(dataSet, "older_version.opx");
+
+		// Act
+		var docOptional = loader.load(validXmlFile.toString());
+
+		// Assert
+		assertTrue(docOptional.isPresent());
+	}
+}
