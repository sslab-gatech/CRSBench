{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-122",
              "name": "CWE-122: Heap-based Buffer Overflow",
              "shortDescription": {
                "text": "Heap-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Heap-based Buffer Overflow"
              }
            },
            {
              "id": "CWE-839",
              "name": "CWE-839: Unknown vulnerability type",
              "shortDescription": {
                "text": "Unknown vulnerability type"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Unknown vulnerability type"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write\nVulnerability: Heap buffer underflow via negative array index in heap_bof\nDescription: A heap buffer overflow vulnerability exists in the heap_bof function due to\ninsufficient bounds checking on array indices. The function only validates the\nupper bound (index < 100) but fails to check for negative values. When a\nnegative index is provided through user-controlled input, it passes the\nvalidation check and causes an out-of-bounds write before the start of the\nallocated heap buffer. This can corrupt heap metadata and potentially lead to\narbitrary code execution or denial of service. The vulnerability is triggered\nwhen the FuzzInput structure contains 'A' in the first byte and a negative\ninteger (e.g., -1) as the index value.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 13,
                  "startColumn": 23,
                  "endColumn": 23
                }
              },
              "logicalLocations": [
                {
                  "name": "heap_bof",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-122",
          "level": "warning",
          "message": {
            "text": "CWE-122 - Heap-based Buffer Overflow\nVulnerability: Heap buffer underflow via negative array index in heap_bof\nDescription: A heap buffer overflow vulnerability exists in the heap_bof function due to\ninsufficient bounds checking on array indices. The function only validates the\nupper bound (index < 100) but fails to check for negative values. When a\nnegative index is provided through user-controlled input, it passes the\nvalidation check and causes an out-of-bounds write before the start of the\nallocated heap buffer. This can corrupt heap metadata and potentially lead to\narbitrary code execution or denial of service. The vulnerability is triggered\nwhen the FuzzInput structure contains 'A' in the first byte and a negative\ninteger (e.g., -1) as the index value.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 13,
                  "startColumn": 23,
                  "endColumn": 23
                }
              },
              "logicalLocations": [
                {
                  "name": "heap_bof",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-839",
          "level": "warning",
          "message": {
            "text": "CWE-839 - Unknown vulnerability type\nVulnerability: Heap buffer underflow via negative array index in heap_bof\nDescription: A heap buffer overflow vulnerability exists in the heap_bof function due to\ninsufficient bounds checking on array indices. The function only validates the\nupper bound (index < 100) but fails to check for negative values. When a\nnegative index is provided through user-controlled input, it passes the\nvalidation check and causes an out-of-bounds write before the start of the\nallocated heap buffer. This can corrupt heap metadata and potentially lead to\narbitrary code execution or denial of service. The vulnerability is triggered\nwhen the FuzzInput structure contains 'A' in the first byte and a negative\ninteger (e.g., -1) as the index value.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock_vp.c"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 13,
                  "startColumn": 23,
                  "endColumn": 23
                }
              },
              "logicalLocations": [
                {
                  "name": "heap_bof",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}