+char *itoa(int val, char *s)
+{
+    char tmp = '\0';
+    char *t = s;
+    char *ret = s;
+
+    if (val == 0)
+        return strcpy(s, "0");
+
+    if (val == -2147483648)
+        return strcpy(s, "-2147483648");
+
+    if (val < 0) {
+        s++;
+        *t++ = '-';
+        val = -val;
+    }
+
+    while (val) {
+        *t++ = '0' + val % 10;
+        val /= 10;
+    }
+    *t-- = '\0';
+
+    while (t - s > 0) {
+        tmp = *s;
+        *s++ = *t;
+        *t-- = tmp;
+    }
+
+    return ret;
+}
+
+int chal_atoi(char *buf){
+  int dir = 1;
+  int start = 0;
+  if(buf[start] == '-')
+    dir = -1;
+
+  int final = 0;
+  for(int i = start; i < strlen(buf); ++i ){
+    final = final * 10 + buf[i] - '0';
+  }
+  final *= dir;
+
+  return final;
+}
+
