+    public List<Integer> getCxids() {
+        List<Integer> cxidList = new ArrayList<>();
+        for (int i = cxids.nextSetBit(0); i >= 0; i = cxids.nextSetBit(i+1)) {
+            cxidList.add(i);
+            if (i == Integer. MAX_VALUE) {
+                break; // or (i+1) would overflow
+            }
+        }
+        return cxidList;
+    }
