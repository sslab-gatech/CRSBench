+static void test_mg_snprintf(void) {
+  char tmp[100];
+  mg_snprintf(tmp, 100, "%e", 3.33);
+  ASSERT(mg_strcmp(mg_str("3.33e0"), mg_str_n(tmp, 6)) == 0);
+  mg_snprintf(tmp, 100, "%e", 3330000000000.0);
+  ASSERT(mg_strcmp(mg_str("3.33e12"), mg_str_n(tmp, 7)) == 0);
+  mg_snprintf(tmp, 100, "%e", 3000000000000.33);
+  ASSERT(mg_strcmp(mg_str("3e12"), mg_str_n(tmp, 4)) == 0);
+}
+
