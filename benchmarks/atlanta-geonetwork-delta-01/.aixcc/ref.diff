+
+    <!-- See previous comment about the usage of the char ◿ -->
+    <xsl:analyze-string select="$txtWithBr"
+                        regex="[^\n\r◿]+">
+      <!-- Surround text without breaklines inside a p element -->
+      <xsl:matching-substring>
+        <xsl:if test="string(normalize-space(.))">
