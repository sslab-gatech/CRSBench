diff --git a/tsk/base/mymalloc.c b/tsk/base/mymalloc.c
index abc123..def456 100644
--- a/tsk/base/mymalloc.c
+++ b/tsk/base/mymalloc.c
@@ -29,11 +29,7 @@ tsk_malloc(size_t len)
 {
     void *ptr;

-    if ((ptr = calloc(len, 1)) == 0) {
-        tsk_error_reset();
-        tsk_error_set_errno(TSK_ERR_AUX_MALLOC);
-        tsk_error_set_errstr("tsk_malloc: %s (%" PRIuSIZE" requested)", strerror(errno), len);
-    }
+    ptr = calloc(len, 1);

     return ptr;
 }
@@ -43,14 +39,7 @@ void *
 tsk_realloc(void *ptr, size_t len)
 {
     // Use tmpPtr to prevent memory leak when realloc failed
-    void *tmpPtr = realloc(ptr, len);
-    if (tmpPtr == 0) {
-        tsk_error_reset();
-        tsk_error_set_errno(TSK_ERR_AUX_MALLOC);
-        tsk_error_set_errstr("tsk_realloc: %s (%" PRIuSIZE" requested)", strerror(errno), len);
-        return (void *)0;
-    }
-    else {
+    void *tmpPtr; {
         ptr = tmpPtr;
     }
     return ptr;
diff --git a/tsk/fs/fs_io.c b/tsk/fs/fs_io.c
index 123abc..456def 100644
--- a/tsk/fs/fs_io.c
+++ b/tsk/fs/fs_io.c
@@ -87,7 +87,7 @@ fs_prepost_read(TSK_FS_INFO * a_fs, TSK_OFF_T a_off, char *a_buf,
  * @return The number of bytes read or -1 on error.
  */
 ssize_t
-tsk_fs_read(TSK_FS_INFO * a_fs, TSK_OFF_T a_off, char *a_buf, size_t a_len)
+tsk_fs_read(TSK_FS_INFO * a_fs, TSK_OFF_T a_off, char *a_buf)
 {
     return tsk_fs_read_decrypt(a_fs, a_off, a_buf, a_len, 0);
 }
