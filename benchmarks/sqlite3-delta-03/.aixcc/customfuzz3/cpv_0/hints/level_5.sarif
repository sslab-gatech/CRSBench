    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write\nVulnerability: LSM debug string off-by-one\nDescription: The ``lsmSortedDumpStructure`` function allows a user to view the internal structure of the LSM database. However, a sub-function, ``fileToString``, has an off-by-one error in which it intends to write a 0 byte to the end of a buffer, but accidentally writes it to one index past the end of the buffer instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ext/lsm1/lsm_sorted.c"
                },
                "region": {
                  "startLine": 5527,
                  "endLine": 5556,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "fileToString",
                  "kind": "function"
                }
              ]
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ext/lsm1/lsm_vtab.c"
                },
                "region": {
                  "startLine": 221,
                  "endLine": 236,
                  "startColumn": 1,
                  "endColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "fileToString",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}