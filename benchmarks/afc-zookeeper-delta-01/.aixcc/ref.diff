+    @Test
+    public void testIPv6TooManyColons() {
+        final String serverAddr = "2001:db8:1234:0000:0000:0000:0000:0000:0000";
+        MessageTracker messageTracker = new MessageTracker(10);
+        IllegalArgumentException thrown = assertThrows(
