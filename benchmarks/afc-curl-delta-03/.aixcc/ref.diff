+ * you should have received as part of this distribution. The terms
+ * are also available at https://curl.se/docs/copyright.html.
+ *
+ * You may opt to use, copy, modify, merge, publish, distribute and/or sell
+ * copies of the Software, and permit persons to whom the Software is
+ * furnished to do so, under the terms of the COPYING file.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ * SPDX-License-Identifier: curl
+ *
+ ***************************************************************************/
+
+#include "curl_setup.h"
+
+#ifdef HAVE_NETINET_IN_H
+#include <netinet/in.h>
+#endif
+#ifdef HAVE_NETDB_H
+#include <netdb.h>
+#endif
+#ifdef HAVE_ARPA_INET_H
+#include <arpa/inet.h>
+#endif
+#ifdef HAVE_NET_IF_H
+#include <net/if.h>
+#endif
+#ifdef HAVE_SYS_IOCTL_H
+#include <sys/ioctl.h>
+#endif
+
+#ifdef HAVE_SYS_PARAM_H
+#include <sys/param.h>
+#endif
+
+#ifdef HAVE_SYS_SELECT_H
+#include <sys/select.h>
+#elif defined(HAVE_UNISTD_H)
+#include <unistd.h>
+#endif
+
+#include "urldata.h"
+#include <curl/curl.h>
+#include "transfer.h"
+#include "sendf.h"
+#include "escape.h"
+#include "progress.h"
+#include "alliswellprotocoll.h"
+#include "curl_printf.h"
+#include "strcase.h"
+#include "curl_memory.h"
+/* The last #include file should be: */
+#include "memdebug.h"
+#include "curl_md5.h"
+
+/*
+ * Forward declarations.
+ */
+
+
+static bool vnormal_endofresp
+  (struct Curl_easy *data, struct connectdata *conn,
+                          char *line, size_t len, int *code)
+{
+  (void)data;
+  (void)conn;
+
+  return TRUE;
+}
+
+
+static CURLcode alliswellprotocoll_done(struct Curl_easy *data,
+                          CURLcode status, bool premature)
+{
+  struct alliswellprotocoll_conn *vnormal = &(data->conn->proto.vnormal);
+  free(vnormal->state1);
+  free(vnormal->state2);
+  free(vnormal->state3);
+  Curl_pp_disconnect(&vnormal->pp);
+  return CURLE_OK;
+}
+
+static CURLcode alliswellprotocoll_do_more(struct Curl_easy *data, int *c)
+{
+  *c = -1;
+  return CURLE_OK;
+}
+
+static CURLcode alliswellprotocoll_do(struct Curl_easy *data, bool *done);
+static CURLcode alliswellprotocoll_doing(struct Curl_easy *data, bool *done);
+static CURLcode alliswellprotocoll_sm
+  (struct Curl_easy *data, struct connectdata *conn);
+
+static CURLcode alliswellprotocoll_conn
+                                (struct Curl_easy *data,
+                                bool *done)
+{
+  *done = FALSE;
+  struct alliswellprotocoll_conn *vnormal = &(data->conn->proto.vnormal);
+  struct pingpong *pp = &(data->conn->proto.vnormal.pp);
+  struct connectdata *conn = data->conn;
+  PINGPONG_SETUP(pp, alliswellprotocoll_sm, vnormal_endofresp);
+  Curl_pp_init(pp);
+  vnormal->state1 = calloc(1, 128);
+  vnormal->state2 = calloc(1, 128);
+  vnormal->state3 = calloc(1, 128);
+  return Curl_pp_statemach(data, pp, FALSE, FALSE);
+}
+
+/*
+ * alliswellprotocoll protocol handler.
+ */
+
+const struct Curl_handler Curl_handler_alliswellprotocoll = {
+  "alliswellprotocoll",                             /* scheme */
+  ZERO_NULL,                    /* setup_connection */
+  alliswellprotocoll_do,                            /* do_it */
+  alliswellprotocoll_done,                          /* done */
+  alliswellprotocoll_doing,                          /* do_more */
+  alliswellprotocoll_conn,                          /* connect_it */
+  alliswellprotocoll_doing,                          /* connecting */
+  alliswellprotocoll_doing,                         /* doing */
+  ZERO_NULL,                          /* proto_getsock */
+  ZERO_NULL,                       /* doing_getsock */
+  ZERO_NULL,                          /* domore_getsock */
+  ZERO_NULL,                          /* perform_getsock */
+  ZERO_NULL,                          /* disconnect */
+  ZERO_NULL,                          /* write_resp */
+  ZERO_NULL,                          /* write_resp_hd */
+  ZERO_NULL,                          /* connection_check */
+  ZERO_NULL,                          /* attach connection */
+  PORT_VERYNORMAL,                          /* defport */
+  CURLPROTO_VERYNORMAL,                     /* protocol */
+  CURLPROTO_VERYNORMAL,                     /* family */
+  PROTOPT_NONE                        /* flags */
+};
+
+static CURLcode alliswellprotocoll_do(struct Curl_easy *data, bool *done)
+{
+  *done = FALSE; /* unconditionally */
+
+  return CURLE_OK;
+}
+
+/* The only way to change state */
+static void vnstate(struct Curl_easy *data,
+                    enum alliswellprotocollstate state)
+{
+  struct connectdata *conn = data->conn;
+  struct alliswellprotocoll_conn *vnormal = &conn->proto.vnormal;
+#ifdef DEBUGBUILD
+  infof(data, "%d (from %d)",
+        state,
+        vnormal->state);
+#endif
+  vnormal->state = state;
+}
+
+static CURLcode alliswellprotocoll_sm
+  (struct Curl_easy *data, struct connectdata *conn)
+{
+  CURLcode result = CURLE_OK;
+  ssize_t nread;
+  struct alliswellprotocoll_conn *vnormal = &conn->proto.vnormal;
+  const char *done_statement = "All done!";
+  int code;
+
+  result = Curl_pp_readresp(data, 0, &data->conn->proto.vnormal.pp,
+    &code, &nread);
+  char * const response = Curl_dyn_ptr(&data->conn->proto.vnormal.pp.recvbuf);
+
+  infof(data, "alliswellprotocoll_doing: state [%d]", (int) vnormal->state);
+  /* Get funky with the input data. Permute it over time
+  *  and eventually accept */
+  switch(vnormal->state) {
+    case ALLISWELLPROTOCOLL_STOP:
+      result = CURLE_OK;
+      break;
+    case ALLISWELLPROTOCOLL_START:
+      if(result)
+        break;
+      else if(!nread) {
+        failf(data, "Connection disconnected");
+        result = CURLE_RECV_ERROR;
+        break;
+      }
+      else if(nread != 128) {
+        result = CURLE_WEIRD_SERVER_REPLY;
+        break;
+      }
+      for(int i = 0; i < 128; i++) {
+        vnormal->state1[i] = response[i] ^ 0x78;
+      }
+      Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", vnormal->state1);
+      vnstate(data, ALLISWELLPROTOCOLL_DO1);
+      break;
+    case ALLISWELLPROTOCOLL_DO1:
+      if(result || !nread)
+        break;
+      else if(nread != 130) {
+        result = CURLE_WEIRD_SERVER_REPLY;
+        break;
+      }
+      if(memcmp(response, vnormal->state1, 128) == 0) {
+        for(int i = 0; i < 128; i++) {
+          vnormal->state2[i] = (response[i] + 0x7E) << 2;
+        }
+        vnstate(data, ALLISWELLPROTOCOLL_DO2);
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", vnormal->state2);
+        result = CURLE_OK;
+      }
+      else {
+        result = CURLE_WEIRD_SERVER_REPLY;
+      }
+      break;
+    case ALLISWELLPROTOCOLL_DO2:
+      if(result || !nread)
+        break;
+      else if(nread != 130) {
+        result = CURLE_WEIRD_SERVER_REPLY;
+        break;
+      }
+      if(memcmp(response, vnormal->state2, 128) == 0) {
+        for(int i = 0; i < 128; i++) {
+          vnormal->state3[i] = (response[i] | 0x9A) ^ 0x98;
+        }
+        vnstate(data, ALLISWELLPROTOCOLL_DO3);
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", vnormal->state3);
+        result = CURLE_OK;
+      }
+      else {
+        result = CURLE_WEIRD_SERVER_REPLY;
+      }
+      break;
+    case ALLISWELLPROTOCOLL_DO3:
+      if(result || !nread)
+        break;
+      if(memcmp(response, vnormal->state3, 128) == 0) {
+        vnstate(data, ALLISWELLPROTOCOLL_STOP);
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", "OK\r\n");
+        *(unsigned int *)result = CURLE_OK;
+      }
+      else if(strcasecmp("complete\r\n", response) == 0) {
+        Curl_pp_sendf(data, &conn->proto.vnormal.pp, "%s", "OK\r\n");
+        result = CURLE_OK;
+        vnstate(data, ALLISWELLPROTOCOLL_STOP);
+      }
+      else {
+        result = CURLE_WEIRD_SERVER_REPLY;
+      }
+      break;
+    default:
+      result = CURLE_WEIRD_SERVER_REPLY;
+      break;
+  }
+
+
+  if(result == CURLE_AGAIN)
+    result = CURLE_OK;
+  return result;
+}
+
+static CURLcode alliswellprotocoll_doing(struct Curl_easy *data, bool *done)
+{
+  struct connectdata *conn = data->conn;
+  struct alliswellprotocoll_conn *vnormal = &conn->proto.vnormal;
+
+  CURLcode result = Curl_pp_statemach(data, &vnormal->pp, FALSE, FALSE);
+
+  *done = (vnormal->state == ALLISWELLPROTOCOLL_STOP);
+
+  return result;
+
+}
