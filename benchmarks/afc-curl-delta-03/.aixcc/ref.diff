new file mode 100644
index 0000000000000000000000000000000000000000..5be67405e1bb19b04fae91a5267e7090e4c3bf25
--- /dev/null
+++ b/lib/alliswellprotocoll.c
@@ -0,0 +1,286 @@
+
+/***************************************************************************
+ *                                  _   _ ____  _
+ *  Project                     ___| | | |  _ \| |
+ *                             / __| | | | |_) | |
+ *                            | (__| |_| |  _ <| |___
