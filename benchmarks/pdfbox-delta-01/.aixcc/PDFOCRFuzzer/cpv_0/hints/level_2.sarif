{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-77",
              "name": "CWE-77: Improper Neutralization of Special Elements used in a Command ('Command Injection')",
              "shortDescription": {
                "text": "Improper Neutralization of Special Elements used in a Command ('Command Injection')"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Improper Neutralization of Special Elements used in a Command ('Command Injection')"
              }
            },
            {
              "id": "CWE-28",
              "name": "CWE-28: Path Traversal: '..\\filedir'",
              "shortDescription": {
                "text": "Path Traversal: '..\\filedir'"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Path Traversal: '..\\filedir'"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-77",
          "level": "warning",
          "message": {
            "text": "CWE-77 - Improper Neutralization of Special Elements used in a Command ('Command Injection')"
          }
        },
        {
          "ruleId": "CWE-28",
          "level": "warning",
          "message": {
            "text": "CWE-28 - Path Traversal: '..\\filedir'"
          }
        }
      ]
    }
  ]
}