+public class ArrayNode
+    extends ContainerNode<ArrayNode>
+{
+    private final List<JsonNode> _children;
+
+    public ArrayNode(JsonNodeFactory nf) {
+        super(nf);
+        _children = new ArrayList<JsonNode>();
