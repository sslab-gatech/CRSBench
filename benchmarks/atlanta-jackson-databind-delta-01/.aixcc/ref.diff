+
+// for [databind#884]
+public class BeanPropertyMapTest extends BaseMapTest
+{
+    protected final static JavaType BOGUS_TYPE = TypeFactory.unknownType();
+    
+    @SuppressWarnings("serial")
+    static class MyObjectIdReader extends ObjectIdReader
+    {
