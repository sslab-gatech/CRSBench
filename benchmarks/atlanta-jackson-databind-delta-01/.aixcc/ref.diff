+
+        assertEquals(1, output.l.size());
+        assertEquals(1, output.m.size());
+
+        assertEquals(13, output.l.get(0).id);
+        Poly p = output.m.get("a");
+        assertNotNull(p);
+        assertEquals(13, p.id);
+    }
+}
