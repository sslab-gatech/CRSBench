+                    if (bean.getClass() != _beanType.getRawClass()) {
+                        /* 23-Jul-2012, tatu: Not sure if these could ever be properly
+                         *   supported (since ordering of elements may not be guaranteed);
+                         *   but make explicitly non-supported for now.
+                         */
