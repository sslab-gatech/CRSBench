+                p.close();
+            } catch (IOException e) { // should not occur, no real i/o...
+                if (e instanceof JsonMappingException) {
+                    throw (JsonMappingException) e;
+                }
+                // 17-Mar-2017, tatu: Really ought not happen...
+                throw JsonMappingException.fromUnexpectedIOE(e);
+            }
