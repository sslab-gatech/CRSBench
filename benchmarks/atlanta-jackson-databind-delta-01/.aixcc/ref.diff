+    }
+
+    @Override
+    public MapLikeType withTypeHandler(Object h) {
+        return new MapLikeType(_class, _bindings, _superClass,
+                _superInterfaces, _keyType, _valueType, _valueHandler, h,
+                _asStatic);
+    }
+
+    @Override
