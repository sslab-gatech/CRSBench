+            String key = getPropertyName(prop);
+            int slot = _hashCode(key);
+            int ix = (slot<<1);
+
+            // primary slot not free?
+            if (hashed[ix] != null) {
+                // secondary?
+                ix = (hashSize + (slot >> 1)) << 1;
+                if (hashed[ix] != null) {
+                    // ok, spill over.
+                    ix = ((hashSize + (hashSize >> 1) ) << 1) + spillCount;
+                    spillCount += 2;
+                    if (ix >= hashed.length) {
