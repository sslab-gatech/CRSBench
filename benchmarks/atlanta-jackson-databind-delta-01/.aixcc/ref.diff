+    @Deprecated
+    public boolean hasAnyGetterAnnotation(AnnotatedMethod am) {
+        return false;
+    }
+    
+    /*
+    /**********************************************************
+    /* Deserialization: general annotations
+    /**********************************************************
+     */
+
+    /**
+     * Method for getting a deserializer definition on specified method
