+    
+    private final void _checkNativeIds(JsonParser jp) throws IOException
+    {
+        if ((_typeId = jp.getTypeId()) != null) {
+            _hasNativeId = true;
+        }
+        if ((_objectId = jp.getObjectId()) != null) {
+            _hasNativeId = true;
+        }
+    }
