+    {
+        for (Map.Entry<String, JsonNode> entry : _children.entrySet()) {
+            if (fieldName.equals(entry.getKey())) {
+                return entry.getValue();
+            }
+            JsonNode value = entry.getValue().findValue(fieldName);
+            if (value != null) {
+                return value;
+            }
+        }
+        return null;
+    }
