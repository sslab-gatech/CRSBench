+        _contextAnnotations = base._contextAnnotations;
+        _declaredType = base._declaredType;
+
+        _member = base._member;
+        _accessorMethod = base._accessorMethod;
+        _field = base._field;
+
+        _serializer = base._serializer;
+        _nullSerializer = base._nullSerializer;
