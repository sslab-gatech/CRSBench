+            // and with that, ask filter to handle it
+            prop.reset(keyElem, valueElem, keySerializer, valueSer);
+            try {
+                filter.serializeAsField(value, gen, provider, prop);
+            } catch (Exception e) {
+                wrapAndThrow(provider, e, value, String.valueOf(keyElem));
+            }
+        }
