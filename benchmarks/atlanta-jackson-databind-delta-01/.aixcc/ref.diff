+        _verifyProperty(beanDesc, true, false, "13");
+        // and then via ser:
+        beanDesc = MAPPER.getSerializationConfig().introspect(MAPPER.constructType(PropDescBean.class));
+        _verifyProperty(beanDesc, true, false, "13");
+    }
