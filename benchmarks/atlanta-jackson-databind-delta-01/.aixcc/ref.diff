+        JavaType subtype = tf.constructSpecializedType(base, RefinedDataList1604.class);
+        assertEquals(RefinedDataList1604.class, subtype.getRawClass());
+        assertEquals(DataList1604.class, subtype.getSuperClass().getRawClass());
